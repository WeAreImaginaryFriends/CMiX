<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The colors of the sync dots. Change a color here, in one place. They are colors of the theme (Colors.axaml), so a dot has the
         red and the orange of every danger and warning of the application, and can be seen on every panel. -->
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{DynamicResource PopupCardDanger}" />
    <SolidColorBrush x:Key="StatusConnectedBrush" Color="{DynamicResource StatusSuccess}" />
    <SolidColorBrush x:Key="StatusUnsyncedBrush" Color="{DynamicResource PopupCardWarning}" />
    <SolidColorBrush x:Key="StatusPendingBrush" Color="{DynamicResource Grey800}" />
    <SolidColorBrush x:Key="StatusSyncedBrush" Color="{DynamicResource AccentPrimary}" />

    <!-- Four states: disconnected (default, red) means the peer has no store connection. Connected
         (.connected, green) means it is connected to Redis and in sync. Connected and not in sync
         (.connected.unsynced, orange) means it is connected but the project is different from the Redis state.
         Pending (.connecting, gray) means a connect or reconnect attempt is in progress, so a momentary red
         does not read as a failure.
         Consumers bind Classes.connected to IsConnected, Classes.unsynced to !IsInSync and Classes.connecting to
         the Status text through SyncStatusIsConnecting; .connecting wins over the others. -->
    <ControlTheme x:Key="EllipseSyncConnection" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource StatusDisconnectedBrush}" />
        <Style Selector="^.connected">
            <Setter Property="Fill" Value="{DynamicResource StatusConnectedBrush}" />
        </Style>
        <Style Selector="^.connected.unsynced">
            <Setter Property="Fill" Value="{DynamicResource StatusUnsyncedBrush}" />
        </Style>
        <Style Selector="^.connecting">
            <Setter Property="Fill" Value="{DynamicResource StatusPendingBrush}" />
        </Style>
    </ControlTheme>

    <!-- Same shape as EllipseSyncConnection, different color. -->
    <ControlTheme x:Key="EllipseSyncState" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource StatusPendingBrush}" />
        <Style Selector="^.insync">
            <Setter Property="Fill" Value="{DynamicResource StatusSyncedBrush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
