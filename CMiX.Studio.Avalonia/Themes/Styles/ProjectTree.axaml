<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
    xmlns:StudioConverters="clr-namespace:CMiX.Studio.Avalonia.Converters">

    <!-- The tree of the project. A row is as high as the rows of the other lists: one control height,
         with the space SpacingXXS between two rows. The two sizes are TreeRowHeight and TreeRowSpacing: the same values in
         whole pixels of the screen (see ProjectTreeView), so the rows are always one same pitch apart.
         It has a fill in the color of its kind (see CategoryPalette), one step brighter when the pointer is over the row itself
         (not over its children), and one more step when it is selected. A child is indented by its level.
         TreeDropMark sets the classes droptarget, dropgap and droptop.
         The classes dropgap and droptop show the place of a drag between rows. The class droptarget shows the row
         that takes a drop inside it: it looks as if the pointer was over it. The class dropblocked shows a row that takes the
         kind of the dragged node but refuses it by a rule: a thin frame, and the reason in the tooltip. The marks are drawn
         over the row and take no room, so the rows never move during a drag. -->
    <converters:MarginMultiplierConverter x:Key="TreeLevelIndent" Indent="{StaticResource TreeIndent}" Left="True" />

    <!-- The tones of a row: the fill behind it and the colors of its count squares, by the kind of the row (see CategoryPalette). -->
    <StudioConverters:TreeToneConverter x:Key="TreeTone" />

    <!-- The cover of a row: the dim of a drag, or the dim of the search while no drag runs (see TreeCoverConverter). -->
    <StudioConverters:TreeCoverConverter x:Key="TreeCover" />

    <!-- How much of the cover stays over a row that can not take a dragged node. -->
    <x:Double x:Key="TreeDimOpacity">0.6</x:Double>

    <ControlTheme x:Key="TreeChevronToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{DynamicResource TreeIndent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Path
                        Name="Chevron"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 0 8"
                        RenderTransformOrigin="40%,50%"
                        Stroke="{DynamicResource ForegroundBrush}"
                        StrokeThickness="1.5" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TreeViewItemCMiX" TargetType="TreeViewItem">
        <!-- The row with the keyboard focus shows the FocusFrame of the template. The dotted frame of Avalonia is not wanted. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The marks of a drag are drawn over the whole item: the row and the rows under it. -->
                <Panel>
                <StackPanel>
                    <!-- The chevron is at the left of the colored row, outside it, after the indent of the row. The toggles are inside the colored
                         row, at its right end, as icons with no fill (see RowToggles). Only the chevron expands a row. -->
                    <Grid Name="RowGrid" ColumnDefinitions="Auto,*">
                    <ToggleButton
                        Name="PART_ExpandCollapseChevron"
                        Grid.Column="0"
                        Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                        IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        Theme="{StaticResource TreeChevronToggle}" />
                    <Border
                        Name="RowBorder"
                        Grid.Column="1"
                        Height="{DynamicResource TreeRowHeight}"
                        Classes.candidate="{Binding IsDropCandidate}"
                        Classes.group="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}"
                        Classes.dragsource="{Binding IsDragSource}"
                        Classes.dropblocked="{Binding IsDropBlocked}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        TextElement.Foreground="{DynamicResource ForegroundBrush}"
                        ToolTip.Tip="{Binding DropBlockReason}">
                        <Panel>
                            <!-- The header has no part names that TreeViewItem knows (PART_Header, PART_HeaderPresenter):
                                 it expands and collapses the row on a double tap of such a part, and a double tap on a row
                                 renames it. -->
                            <Grid
                                Name="RowContent"
                                ColumnDefinitions="*,Auto"
                                Margin="{DynamicResource TreeRowContentMargin}">
                                <ContentPresenter
                                    Name="RowHeaderPresenter"
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                <Views:RowToggles Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                            <!-- The marks of a drag over the rows, drawn over the row: they take no room and no click. A row that can not take
                                 the node is covered with the background of the tree, so it recedes. A row that can take it has a
                                 brighter fill (the class candidate, see the styles below), and no border. While no drag runs, a row that
                                 does not match the search is covered in the same way, so only the matches keep their color. -->
                            <Border
                                Name="DimLayer"
                                Background="{DynamicResource TreeBackgroundBrush}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <Classes.dimmed>
                                    <MultiBinding Converter="{StaticResource TreeCover}">
                                        <Binding Path="IsDimmed" />
                                        <Binding Path="IsSearchDimmed" />
                                        <Binding Path="IsDragActive" />
                                    </MultiBinding>
                                </Classes.dimmed>
                                <!-- The cover fades in and out (Motion.FadeDuration), so a row does not jump when a drag starts or ends. -->
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <!-- The selected row has a thin border in the bright color of its kind. It is drawn over the row, inside it, so the row
                                 does not change its size. Its thickness is one pixel of the screen (see ProjectTreeView.SetRowMetrics). -->
                            <Border
                                Name="SelectionFrame"
                                BorderBrush="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}"
                                BorderThickness="{DynamicResource TreeSelectionThickness}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                            <!-- The cursor row has the keyboard focus (:focus-visible): a thin border in the bright color of its kind,
                                 with no fill change. The style sets the thickness, so the hidden frame has none. The arrow keys move it. Enter or a click selects the row. -->
                            <Border
                                Name="FocusFrame"
                                BorderBrush="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                            <!-- The frame of a row that refuses the dragged node (the class dropblocked). It is drawn over the row, as the selection frame. -->
                            <Border
                                Name="BlockedFrame"
                                BorderBrush="{DynamicResource WarningMutedBrush}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                        </Panel>
                    </Border>
                    </Grid>
                    <!-- The space under the row (TreeRowGap) is a part of the item of the row, so it follows the row whatever is open: every
                         row is one row height plus one space from the next, and the pitch of the rows never changes. The drop line is a
                         part of the item too, and it fills this space. -->
                    <Border Name="GapUnderTheRow" Height="{DynamicResource TreeRowGap}" />
                    <!-- The same animation as the expanders. The panel owns the IsVisible of the presenter. -->
                    <ui:CollapsePanel Name="PART_Collapse" IsExpanded="{TemplateBinding IsExpanded}">
                        <Panel>
                            <ItemsPresenter
                                Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Panel>
                    </ui:CollapsePanel>
                </StackPanel>
                <!-- The line starts where the colored row starts: after the indent of the row and its chevron (TreeIndent). It is inside the item:
                     at its top for a drop before the row, and at its bottom for a drop after it. An item cuts what is drawn outside it,
                     so a line in the space between two rows would not be seen. -->
                <Panel
                    Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                    IsHitTestVisible="False">
                    <Border
                        Name="DropLine"
                        Height="{DynamicResource SplitterIndicatorSize}"
                        Margin="{DynamicResource TreeIndentMargin}"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />
                </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The fill of a row is the tone of its kind. It is a style, not a value of the template, so the states below can replace it.
             A row with no fill would not take the pointer, so a row of an unknown kind has a clear fill. -->
        <Style Selector="^ /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=Fill}" />
        </Style>
        <!-- The row that is dragged stays in its place, faded: the copy of it follows the pointer (see TreeDragGhost). -->
        <Style Selector="^ /template/ Border#RowBorder.dragsource">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- A row that can take the node that is dragged has the fill of a row under the pointer, so it stands out from the rows that can not. -->
        <Style Selector="^ /template/ Border#RowBorder.candidate">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillHover}" />
        </Style>
        <!-- The pointer is tested on the row, not on the item: the item also contains its children. A row under the pointer is as bright as a
             selected row, without the border. -->
        <Style Selector="^ /template/ Border#RowBorder:pointerover">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#SelectionFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#FocusFrame">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderThickness" Value="{DynamicResource TreeSelectionThickness}" />
        </Style>
        <Style Selector="^:selected /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <!-- The row that takes the node or the files that are dragged over it, inside it: it is brighter than the other rows that take it. -->
        <Style Selector="^:droptarget /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillSelected}" />
        </Style>
        <!-- A group row (a row with no item, such as Entities) with no children has a grey fill, not the tone of its kind. An item row,
             such as a modulator, keeps the tone of its kind, also with no children. The styles come after the tone styles, so they
             replace them. The :empty class follows the number of children, so the fill changes when a group gets its first child or
             loses its last one. The frames keep the color of the kind. -->
        <Style Selector="^:empty /template/ Border#RowBorder.group">
            <Setter Property="Background" Value="{DynamicResource Grey300Brush}" />
        </Style>
        <Style Selector="^:empty /template/ Border#RowBorder.group.candidate">
            <Setter Property="Background" Value="{DynamicResource Grey400Brush}" />
        </Style>
        <Style Selector="^:empty /template/ Border#RowBorder.group:pointerover">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^:empty:selected /template/ Border#RowBorder.group">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^:empty:droptarget /template/ Border#RowBorder.group">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^ /template/ Border#DimLayer.dimmed">
            <Setter Property="Opacity" Value="{DynamicResource TreeDimOpacity}" />
        </Style>
        <!-- A row that refuses the dragged node keeps its fill and shows a thin frame in a muted warning tone. -->
        <Style Selector="^ /template/ Border#RowBorder.dropblocked Border#BlockedFrame">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderThickness" Value="{DynamicResource TreeSelectionThickness}" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <!-- The chevron keeps its room: it holds the indent of the row, so an empty row stays aligned with the rows around it. -->
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- An empty list of children takes no room, and adds no space below the row. -->
        <Style Selector="^:empty /template/ ui|CollapsePanel#PART_Collapse">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The line of a drop between two rows is in the space under the row above the place: it fills that space, so it is
             exactly in the middle between the two rows. The first row of the tree has no row above it: the line is at its top. -->
        <Style Selector="^:dropgap /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Height" Value="{DynamicResource TreeRowGap}" />
            <Setter Property="Margin" Value="{DynamicResource TreeDropLineGapMargin}" />
        </Style>
        <Style Selector="^:droptop /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
