<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
    xmlns:StudioConverters="clr-namespace:CMiX.Studio.Avalonia.Converters">

    <!-- The tree of the project. A row is as high as the rows of the other lists: one control height,
         with the space SpacingXXS between two rows. The two sizes are TreeRowHeight and TreeRowSpacing: the same values in
         whole pixels of the screen (see ProjectTreeView), so the rows are always one same pitch apart.
         It has a fill in the color of its kind (see CategoryPalette), one step brighter when the pointer is over the row itself
         (not over its children), and one more step when it is selected. A child is indented by its level.
         The classes dropbefore and dropafter show the place of a drag between rows. The class droptarget shows the row
         that takes a drop inside it: it looks as if the pointer was over it. The marks are drawn
         over the row and take no room, so the rows never move during a drag. -->
    <converters:MarginMultiplierConverter x:Key="TreeLevelIndent" Indent="16" Left="True" />

    <!-- The tones of a row: the fill behind it and the colors of its count squares, by the kind of the row (see CategoryPalette). -->
    <StudioConverters:TreeToneConverter x:Key="TreeTone" />

    <!-- How much of the cover stays over a row that can not take a dragged node. -->
    <x:Double x:Key="TreeDimOpacity">0.6</x:Double>

    <ControlTheme x:Key="TreeChevronToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Path
                        Name="Chevron"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 0 8"
                        RenderTransformOrigin="40%,50%"
                        Stroke="{DynamicResource ForegroundBrush}"
                        StrokeThickness="1.5" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TreeViewItemCMiX" TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource TreeRowGap}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The marks of a drag are drawn over the whole item: the row and the rows under it. -->
                <Panel>
                <StackPanel>
                    <!-- The toggles are at the right of the colored row, outside it. The column starts with the space of the rows. -->
                    <Grid ColumnDefinitions="*,Auto">
                    <Border
                        Name="RowBorder"
                        Height="{DynamicResource TreeRowHeight}"
                        Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                        Classes.candidate="{Binding IsDropCandidate}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        TextElement.Foreground="{DynamicResource ForegroundBrush}">
                        <Panel>
                            <!-- The header has no part names that TreeViewItem knows (PART_Header, PART_HeaderPresenter):
                                 it expands and collapses the row on a double tap of such a part, and a double tap on a row
                                 renames it. Only the chevron expands a row. -->
                            <Grid
                                Name="RowContent"
                                Margin="2,0,0,0"
                                ColumnDefinitions="16,*">
                                <ToggleButton
                                    Name="PART_ExpandCollapseChevron"
                                    Grid.Column="0"
                                    IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                    Theme="{StaticResource TreeChevronToggle}" />
                                <ContentPresenter
                                    Name="RowHeaderPresenter"
                                    Grid.Column="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            </Grid>
                            <!-- The marks of a drag over the rows, drawn over the row: they take no room and no click. A row that can not take
                                 the node is covered with the background of the panel, so it recedes. A row that can take it has a
                                 brighter fill (the class candidate, see the styles below), and no border. -->
                            <Border
                                Name="DimLayer"
                                Background="{DynamicResource PanelBackgroundLevel1Brush}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="{Binding IsDimmed}"
                                Opacity="{DynamicResource TreeDimOpacity}" />
                            <!-- The selected row has a thin border in the bright color of its kind. It is drawn over the row, inside it, so the row
                                 does not change its size. Its thickness is one pixel of the screen (see ProjectTreeView.SetRowMetrics). -->
                            <Border
                                Name="SelectionFrame"
                                BorderBrush="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}"
                                BorderThickness="{DynamicResource TreeSelectionThickness}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                        </Panel>
                    </Border>
                    <Views:RowToggles Grid.Column="1" />
                    </Grid>
                    <!-- The same animation as the expanders. The panel owns the IsVisible of the presenter. -->
                    <!-- The space between the row and its first child is inside the panel. A closed panel has no height, so
                         a closed row is followed by the same space as an open row: every row is one row height plus one space
                         from the next, whatever is open, so the pitch of the rows never changes. -->
                    <ui:CollapsePanel Name="PART_Collapse" IsExpanded="{TemplateBinding IsExpanded}">
                        <Panel>
                            <StackPanel Spacing="{DynamicResource TreeRowGap}">
                                <Border />
                                <ItemsPresenter
                                    Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </StackPanel>
                            <!-- The pipe: a line under the chevron, along the children of the row. It is drawn over the
                                 children, so a hovered or selected child does not hide it. The margin is the indent of the
                                 row, as for the chevron. The line is at the middle of the chevron: 2 for the padding of
                                 the row and 8 for half of the chevron column. -->
                            <Panel
                                Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                                IsHitTestVisible="False">
                                <Border
                                    Name="Pipe"
                                    Width="1"
                                    Margin="10,4,0,4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Grey500Brush}" />
                            </Panel>
                        </Panel>
                    </ui:CollapsePanel>
                </StackPanel>
                <!-- The line starts at the indent of the row, as the colored row does. It is inside the item: at its top for a drop
                     before the row, and at its bottom for a drop after it. An item cuts what is drawn outside it, so a line in the space
                     between two rows would not be seen. -->
                <Panel
                    Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                    IsHitTestVisible="False">
                    <Border
                        Name="DropLine"
                        Height="{DynamicResource SplitterIndicatorSize}"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />
                </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The fill of a row is the tone of its kind. It is a style, not a value of the template, so the states below can replace it.
             A row with no fill would not take the pointer, so a row of an unknown kind has a clear fill. -->
        <Style Selector="^ /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=Fill}" />
        </Style>
        <!-- A row that can take the node that is dragged has the fill of a row under the pointer, so it stands out from the rows that can not. -->
        <Style Selector="^ /template/ Border#RowBorder.candidate">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillHover}" />
        </Style>
        <!-- The pointer is tested on the row, not on the item: the item also contains its children. -->
        <Style Selector="^ /template/ Border#RowBorder:pointerover">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#SelectionFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:selected /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <!-- The row that takes the node or the files that are dragged over it, inside it: it is brighter than the other rows that take it. -->
        <Style Selector="^:droptarget /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillSelected}" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- An empty list of children takes no room, and adds no space below the row. -->
        <Style Selector="^:empty /template/ ui|CollapsePanel#PART_Collapse">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:dropbefore /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^:dropafter /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
