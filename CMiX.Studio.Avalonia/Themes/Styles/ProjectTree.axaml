<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls">

    <!-- The tree of the project. A row is as high as the rows of the other lists: one control height,
         with the space SpacingXXS between two rows.
         It is transparent, grey when the pointer is over the row itself (not over its children), and blue
         when it is selected. A child is indented by its level.
         The classes dropbefore, dropafter and dropinside show the place of a drag. The marks are drawn
         over the row and take no room, so the rows never move during a drag. -->
    <converters:MarginMultiplierConverter x:Key="TreeLevelIndent" Indent="16" Left="True" />

    <ControlTheme x:Key="TreeChevronToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Path
                        Name="Chevron"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 0 8"
                        RenderTransformOrigin="40%,50%"
                        Stroke="{DynamicResource ForegroundBrush}"
                        StrokeThickness="1.5" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TreeViewItemCMiX" TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource SpacingXXS}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="{DynamicResource SpacingXXS}">
                    <Border
                        Name="RowBorder"
                        Height="{DynamicResource ControlHeightMD}"
                        Padding="2,0,0,0"
                        Background="Transparent"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        TextElement.Foreground="{DynamicResource ForegroundBrush}">
                        <Panel>
                            <!-- The header has no part names that TreeViewItem knows (PART_Header, PART_HeaderPresenter):
                                 it expands and collapses the row on a double tap of such a part, and a double tap on a row
                                 renames it. Only the chevron expands a row. -->
                            <Grid
                                Name="RowContent"
                                Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                                ColumnDefinitions="16,*">
                                <ToggleButton
                                    Name="PART_ExpandCollapseChevron"
                                    Grid.Column="0"
                                    IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                    Theme="{StaticResource TreeChevronToggle}" />
                                <ContentPresenter
                                    Name="RowHeaderPresenter"
                                    Grid.Column="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            </Grid>
                            <Border
                                Name="DropLine"
                                Height="{DynamicResource SplitterIndicatorSize}"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                            <Border
                                Name="DropFrame"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                        </Panel>
                    </Border>
                    <ItemsPresenter
                        Name="PART_ItemsPresenter"
                        IsVisible="{TemplateBinding IsExpanded}"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <!-- The pointer is tested on the row, not on the item: the item also contains its children. -->
        <Style Selector="^ /template/ Border#RowBorder:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#RowBorder">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#RowBorder:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- An empty list of children takes no room, and adds no space below the row. -->
        <Style Selector="^:empty /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:dropbefore /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^:dropafter /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^:dropinside /template/ Border#DropFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
