<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Pulse"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="pulse">

    <StackPanel>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <Modulation:DragValueModulatable
                Caption="Center"
                DataContext="{Binding Center}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=pulse}" />

            <Modulation:DragValueModulatable
                Caption="Slope Width"
                Minimum="0"
                DataContext="{Binding SlopeWidth}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=pulse}" />

            <Modulation:DragValueModulatable
                Caption="Center Width"
                Minimum="0"
                DataContext="{Binding CenterWidth}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=pulse}" />

        </ui:StackPanelPositioned>

        <ui:ComboBoxCaptioned
            Margin="0,8"
            Caption="Channel"
            ItemsSource="{x:Static Resources:EnumProviders.PulseChannel}"
            ResetCommand="{Binding Channel.ResetCommand}"
            SelectedItem="{Binding Channel.Value}" />

        <ui:ToggleButtonCaptioned
            Caption="Invert"
            IsChecked="{Binding Invert.Value}"
            ResetCommand="{Binding Invert.ResetCommand}" />

    </StackPanel>

</Views:FilterPanel>
