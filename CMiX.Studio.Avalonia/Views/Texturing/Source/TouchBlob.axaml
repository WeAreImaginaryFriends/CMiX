<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TouchBlob"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <ui:DragValue
            Caption="Size"
            Value="{Binding Size.Value}"
            ResetCommand="{Binding Size.ResetCommand}" />

        <ui:StackPanelPositioned Margin="0,8" Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Color"
                DataContext="{Binding Color}" />

            <ui:ColorSelector
                Caption="Background"
                DataContext="{Binding Background}" />

        </ui:StackPanelPositioned>

        <Views:TextureResolution />

    </StackPanel>

</UserControl>
