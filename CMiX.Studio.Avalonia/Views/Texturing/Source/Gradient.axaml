<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Gradient"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="gradient">

    <StackPanel>

        <Modulation:DragValueModulatable
            Margin="0,0,0,8"
            Caption="Gamma"
            DataContext="{Binding Gamma}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=gradient}" />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="From"
                DataContext="{Binding From}" />

            <ui:ColorSelector
                Caption="To"
                DataContext="{Binding To}" />

        </ui:StackPanelPositioned>

        <ui:ToggleButtonCaptioned
            Margin="0,8"
            Caption="Horizontal"
            IsChecked="{Binding Horizontal.Value}"
            ResetCommand="{Binding Horizontal.ResetCommand}" />

        <Views:TextureResolution />

    </StackPanel>

</Modulation:PanelModulatable>
