<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.BubbleNoise"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="bubbleNoise">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <Modulation:DragValueModulatable
                Caption="Time"
                DataContext="{Binding Time}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=bubbleNoise}" />

            <Modulation:DragValueModulatable
                Caption="Frequency"
                DataContext="{Binding Frequency}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=bubbleNoise}" />

            <Modulation:DragValueModulatable
                Caption="Contrast"
                DataContext="{Binding Contrast}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=bubbleNoise}" />

        </ui:StackPanelPositioned>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Background"
                DataContext="{Binding BackgroundColor}" />

            <ui:ColorSelector
                Caption="Bubble"
                DataContext="{Binding BubbleColor}" />

        </ui:StackPanelPositioned>

        <Views:TextureResolution />

    </StackPanel>

</Modulation:PanelModulatable>
