<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Image"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:AssetPathSelector
            VerticalAlignment="Top"
            DataContext="{Binding AssetSelector}"
            ItemsSource="{Binding AssetRepository.Images}"
            SelectedItem="{Binding Asset}" />

        <Views:TextureResolution />

    </StackPanel>

</UserControl>
