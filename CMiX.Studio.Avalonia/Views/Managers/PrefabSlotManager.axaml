<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.PrefabSlotManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    x:Name="prefabSlotManager"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <ui:ListBoxCMiX
            x:Name="prefabListBox"
            MinItemCount="{Binding MinItemCount, ElementName=prefabSlotManager}"
            ItemsSource="{Binding ManagerData.Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <ui:ListBoxCMiX.DataTemplates>
                <Managers:PrefabListItemTemplates />
            </ui:ListBoxCMiX.DataTemplates>
        </ui:ListBoxCMiX>

        <ui:DockPanelPositioned Margin="0,4,0,0">

            <ui:ButtonIcon
                x:Name="RemoveButton"
                Command="{Binding RemoveItemCommand}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
                Classes="filled"
                IconKey="Remove" />

            <ui:ButtonIcon
                x:Name="DuplicateButton"
                Margin="0,0,1,0"
                Command="{Binding DuplicateItemCommand}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
                Classes="filled"
                IconKey="Duplicate" />

            <ui:ButtonIcon
                x:Name="MoveUpButton"
                Margin="1,0"
                Command="{Binding ManagerReorderService.MoveItemUpCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
                Classes="filled"
                IconKey="ArrowUp" />

            <ui:ButtonIcon
                x:Name="MoveDownButton"
                Command="{Binding ManagerReorderService.MoveItemDownCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
                Classes="filled"
                IconKey="ArrowDown" />

            <ToggleButton
                x:Name="SwapToggle"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Content="⇄"
                DockPanel.Dock="Left"
                IsEnabled="{Binding ItemsSource.Count, ElementName=prefabSlotManager, Converter={StaticResource CountToVisibility}, ConverterParameter=0}" />

            <Popup
                ui:TogglePopup.Toggle="{Binding ElementName=SwapToggle}"
                Placement="BottomEdgeAlignedLeft"
                VerticalOffset="-1">
                <ui:DropdownFrame>
                    <ui:SearchableItemPickerList
                        Picked="OnSwapListPicked"
                        ItemCommand="{Binding DataContext.AddExistingItemCommand, ElementName=prefabSlotManager}"
                        ItemsSource="{Binding ItemsSource, ElementName=prefabSlotManager}"
                        TextPath="PrefabService.Name.Value" />
                </ui:DropdownFrame>
            </Popup>

            <!--  SELECTION PANEL (type picker)  -->
            <ContentControl
                Height="{DynamicResource ControlHeightMD}"
                Margin="1,0"
                Content="{Binding SelectionPanel, ElementName=prefabSlotManager}"
                DockPanel.Dock="Left" />

        </ui:DockPanelPositioned>

    </StackPanel>

</UserControl>
