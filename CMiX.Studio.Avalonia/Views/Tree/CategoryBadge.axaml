<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CategoryBadge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The icon of an item in the title bar of the inspector, on the color of the bar. The DataContext is a tree node.
         The square is as high as a row and has no fill of its own: the bar has the color of the kind. The icon is white. The tree
         does not use it: a row of the tree shows its kind with its fill (see TreeToneConverter). -->
    <Border
        Width="{DynamicResource ControlHeightMD}"
        Height="{DynamicResource ControlHeightMD}"
        CornerRadius="{DynamicResource CornerRadiusAll}">
        <ui:AppIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource ActiveForegroundBrush}"
            IconKey="{Binding IconKey}"
            Size="{DynamicResource IconSizeXS}" />
    </Border>

</UserControl>
