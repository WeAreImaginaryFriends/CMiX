<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RowToggles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- The toggles of a row of the tree, inside the colored row, at its right end. The DataContext is the tree node.
         The slots are ComposableToggles of the row size, with no fill: the icons show on the color of the row. The column has the width of the spaces and all the slots (TreeToggleWidth,
         see ProjectTreeView), so the icons of all rows line up. A new toggle is a new slot and a wider column. -->
    <StackPanel
        Width="{DynamicResource TreeToggleWidth}"
        Background="Transparent"
        HorizontalAlignment="Left"
        Orientation="Horizontal"
        Spacing="{DynamicResource TreeRowSpacing}">

        <!-- It has no width: with the space between the children, it makes the space between the colored row and the first square. -->
        <Border Width="0" />

        <Views:ComposableToggles Classes="row" DataContext="{Binding Item}" />

    </StackPanel>

</UserControl>
