<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RowToggles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core">

    <!-- The toggles of a row of the tree, outside the colored row, at its right end. The DataContext is the tree node.
         Each toggle sits on its own square, as high as a row, with the space of the rows (TreeRowSpacing) between two squares.
         The visibility toggle is always the first square, since every item has one, so the visibility toggles line up down the
         tree. The other toggles follow it, to the right. The column has the width of the space and all the squares (TreeToggleWidth, see
         ProjectTreeView), so the colored rows all end at the same place. A new toggle is a new square here, and a wider column.
         A group, and the places without a toggle, have an empty square: it has no button.
         The content is null for a row without a mask toggle. The templates are only for a composition and a layer: a template for any
         object would also catch the text of the tooltip of the toggle, and the tooltip would be an empty box. -->
    <UserControl.Styles>
        <Style Selector="Border.slot">
            <Setter Property="Width" Value="{DynamicResource TreeRowHeight}" />
            <Setter Property="Height" Value="{DynamicResource TreeRowHeight}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel2Brush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        </Style>
    </UserControl.Styles>

    <StackPanel
        Width="{DynamicResource TreeToggleWidth}"
        Background="Transparent"
        HorizontalAlignment="Left"
        Orientation="Horizontal"
        Spacing="{DynamicResource TreeRowSpacing}">

        <!-- It has no width: with the space between the children, it makes the space between the colored row and the first square. -->
        <Border Width="0" />

        <Border Classes="slot">
            <ToggleButton
                IsChecked="{Binding Item.PrefabService.Visibility.Value}"
                IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}"
                Theme="{DynamicResource ToggleButtonVisibility}" />
        </Border>

        <!-- A row without a mask toggle has an empty square here, with no button, so the column looks the same on every row. -->
        <Border Classes="slot" IsVisible="{Binding MaskOwner, Converter={x:Static ObjectConverters.IsNull}}" />

        <!-- The mask toggle: a composition and a layer only. -->
        <ContentControl Content="{Binding MaskOwner}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type Compositing:Composition}">
                    <Border Classes="slot">
                        <ToggleButton
                            IsChecked="{Binding Mask.IsMask.Value}"
                            Theme="{DynamicResource ToggleButtonMask}"
                            ToolTip.Tip="Mask" />
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="{x:Type Compositing:Layer}">
                    <Border Classes="slot">
                        <ToggleButton
                            IsChecked="{Binding Mask.IsMask.Value}"
                            Theme="{DynamicResource ToggleButtonMask}"
                            ToolTip.Tip="Mask" />
                    </Border>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

    </StackPanel>

</UserControl>
