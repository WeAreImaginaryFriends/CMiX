<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RowToggles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- The toggle column of a row of the tree, at the right of the colored row. The DataContext is the tree node.
         The squares are ComposableToggles of the row size. The column has the width of the spaces and all the squares (TreeToggleWidth,
         see ProjectTreeView), so the colored rows all end at the same place. A new toggle is a new square and a wider column. -->
    <StackPanel
        Width="{DynamicResource TreeToggleWidth}"
        Background="Transparent"
        HorizontalAlignment="Left"
        Orientation="Horizontal"
        Spacing="{DynamicResource TreeRowSpacing}">

        <!-- It has no width: with the space between the children, it makes the space between the colored row and the first square. -->
        <Border Width="0" />

        <Views:ComposableToggles Classes="row" DataContext="{Binding Item}" />

    </StackPanel>

</UserControl>
