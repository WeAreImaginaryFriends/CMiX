<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.KindCountBadges"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- What a collapsed row holds: a small square for each kind, in the color of the kind, with how many items of that kind.
         At most TreeNode.MaxShownKindCounts squares show. A grey square "+n" counts the other kinds. After the squares, the text "n hidden"
         in the disabled look counts the hidden rows under the row, so a hidden row is never out of sight.
         The DataContext is the tree node. The squares are at the full color when the pointer is over the row, as when the row is selected (the pseudo classes hovered and selected, set from IsHovered and IsSelected). -->
    <UserControl.Styles>
        <Style Selector="Border.kindcount">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=Kind}" />
        </Style>
        <Style Selector="Views|KindCountBadges:hovered Border.kindcount">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}" />
        </Style>
        <Style Selector="Views|KindCountBadges:selected Border.kindcount">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}" />
        </Style>
        <!-- The number is white on the square at rest. On the full color of a row that is under the pointer or selected, the number is dark
             (the background of the tree): white on the full color is hard to read, most of all on the yellow of a light.
             The color is in a style and not on the TextBlock: a local value is stronger than a style. -->
        <Style Selector="Border.kindcount TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <Style Selector="Views|KindCountBadges:hovered Border.kindcount TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TreeBackgroundBrush}" />
        </Style>
        <Style Selector="Views|KindCountBadges:selected Border.kindcount TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TreeBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXS}">
        <ItemsControl ItemsSource="{Binding ShownKindCounts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXS}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type Tree:KindCount}">
                    <Border
                        Classes="kindcount"
                        Height="{DynamicResource ControlHeightXS}"
                        MinWidth="{DynamicResource ControlHeightXS}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        ToolTip.Tip="{Binding Description}">
                        <TextBlock
                            Margin="4,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Count}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border
            Name="MoreKinds"
            Height="{DynamicResource ControlHeightXS}"
            MinWidth="{DynamicResource ControlHeightXS}"
            VerticalAlignment="Center"
            Background="{DynamicResource Grey600Brush}"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            IsVisible="{Binding HasMoreKinds}"
            ToolTip.Tip="{Binding MoreKindsDescription}">
            <TextBlock
                Margin="4,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ActiveForegroundBrush}"
                Text="{Binding MoreKindsCount, StringFormat='+{0}'}" />
        </Border>

        <TextBlock
            Name="HiddenCount"
            VerticalAlignment="Center"
            Foreground="{DynamicResource ForegroundBrush}"
            IsVisible="{Binding HasHiddenRows}"
            Opacity="{DynamicResource OpacityDisabled}"
            Text="{Binding HiddenCount, StringFormat='{}{0} hidden'}" />
    </StackPanel>

</UserControl>
