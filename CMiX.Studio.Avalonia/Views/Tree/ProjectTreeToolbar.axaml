<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The buttons of the toolbar of the lists of compositions and layers (ComposableManagerToolbar), for the selected node
         of the tree. A button is disabled when the selected node has nothing to do for it. -->
    <DockPanel LastChildFill="False">

        <Button
            x:Name="AddButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Click="OnAddClick"
            IsEnabled="{Binding HasAdds}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="Add" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

        <Button
            x:Name="DuplicateButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding DuplicateItemCommand}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="Duplicate" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

        <Button
            x:Name="MoveUpButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding MoveItemUpCommand}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="ArrowUp" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

        <Button
            x:Name="MoveDownButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding MoveItemDownCommand}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="ArrowDown" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

        <Button
            x:Name="RemoveButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding RemoveItemCommand}"
            DockPanel.Dock="Right"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="Remove" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

    </DockPanel>
</UserControl>
