<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The buttons of the toolbar of the lists of compositions and layers (ComposableManagerToolbar), for the selected node
         of the tree. A button is disabled when the selected node has nothing to do for it. -->
    <DockPanel LastChildFill="False">

        <ui:ButtonIcon
            x:Name="AddButton"
            Click="OnAddClick"
            IsEnabled="{Binding HasAdds}"
            IconKey="Add"
            Tip="Add" />

        <ui:ButtonIcon
            x:Name="DuplicateButton"
            Command="{Binding DuplicateItemCommand}"
            IconKey="Duplicate"
            Tip="Duplicate" />

        <ui:ButtonIcon
            x:Name="MoveUpButton"
            Command="{Binding MoveItemUpCommand}"
            IconKey="ArrowUp"
            Tip="Move up" />

        <ui:ButtonIcon
            x:Name="MoveDownButton"
            Command="{Binding MoveItemDownCommand}"
            IconKey="ArrowDown"
            Tip="Move down" />

        <ui:ButtonIcon
            x:Name="RemoveButton"
            Command="{Binding RemoveItemCommand}"
            DockPanel.Dock="Right"
            IconKey="Remove"
            Tip="Remove" />

    </DockPanel>
</UserControl>
