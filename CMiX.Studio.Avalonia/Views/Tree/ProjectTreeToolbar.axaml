<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The buttons of the toolbar of the lists of compositions and layers (ComposableManagerToolbar), for the selected node
         of the tree. A button is disabled when the selected node has nothing to do for it. -->
    <DockPanel LastChildFill="False">

        <ui:ButtonIcon
            x:Name="AddButton"
            Click="OnAddClick"
            IsEnabled="{Binding HasAdds}"
            IconKey="Add"
            Tip="Add"
            TipShortcut="{Binding Shortcuts[Tree.Add], Converter={StaticResource KeyGestureText}}" />

        <ui:ButtonIcon
            x:Name="DuplicateButton"
            Command="{Binding DuplicateItemCommand}"
            IconKey="Duplicate"
            DisabledReason="Select a row to duplicate."
            Tip="Duplicate"
            TipShortcut="{Binding Shortcuts[Tree.Duplicate], Converter={StaticResource KeyGestureText}}" />

        <ui:ButtonIcon
            x:Name="MoveUpButton"
            Command="{Binding MoveItemUpCommand}"
            IconKey="ArrowUp"
            DisabledReason="Select a row that can move up."
            Tip="Move up"
            TipShortcut="{Binding Shortcuts[Tree.MoveUp], Converter={StaticResource KeyGestureText}}" />

        <ui:ButtonIcon
            x:Name="MoveDownButton"
            Command="{Binding MoveItemDownCommand}"
            IconKey="ArrowDown"
            DisabledReason="Select a row that can move down."
            Tip="Move down"
            TipShortcut="{Binding Shortcuts[Tree.MoveDown], Converter={StaticResource KeyGestureText}}" />

        <ui:ButtonIcon
            x:Name="RemoveButton"
            Command="{Binding RemoveItemCommand}"
            DockPanel.Dock="Right"
            IconKey="Remove"
            DisabledReason="Select a row to remove."
            Tip="Remove"
            TipShortcut="{Binding Shortcuts[Tree.Remove], Converter={StaticResource KeyGestureText}}" />

    </DockPanel>
</UserControl>
