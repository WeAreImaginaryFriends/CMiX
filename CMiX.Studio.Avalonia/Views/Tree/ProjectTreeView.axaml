<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree">

    <TreeView
        x:Name="treeView"
        Background="Transparent"
        BorderThickness="0"
        ItemsSource="{Binding Roots}"
        SelectedItem="{Binding SelectedNode, Mode=TwoWay}">

        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="Theme" Value="{StaticResource TreeViewItemCMiX}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
            <TreeDataTemplate DataType="{x:Type Tree:TreeNode}" ItemsSource="{Binding Children}">
                <Panel>
                    <ui:ListItemIcon
                        Icon="{Binding IconKey}"
                        IsChecked="{Binding Item.PrefabService.Visibility.Value, Mode=TwoWay}"
                        IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Title="{Binding Item.PrefabService.Name.Value, Mode=TwoWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}">
                        <ui:AppIcon IconKey="{Binding IconKey}" Size="{DynamicResource IconSizeXS}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
                    </StackPanel>
                </Panel>
            </TreeDataTemplate>
        </TreeView.DataTemplates>

    </TreeView>

</UserControl>
