<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- The sizes of a row for a screen of 100%: ControlHeightMD and SpacingXXS. The code sets them again in whole pixels of the screen
         (ProjectTreeView.SnapToPixels), from those two tokens. The width of the toggle column comes from them too. -->
    <UserControl.Resources>
        <x:Double x:Key="TreeRowHeight">24</x:Double>
        <x:Double x:Key="TreeRowSpacing">1</x:Double>
        <Thickness x:Key="TreeDropLineGapMargin">16,24,0,0</Thickness>
        <Thickness x:Key="TreeSelectionThickness">1</Thickness>
        <x:Double x:Key="TreeToggleWidth">50</x:Double>
    </UserControl.Resources>

    <!-- The gesture comes from the shortcut map. The binding pauses while a name box is edited (KeyBindingTextGuard). Tree.Open needs the
         focus in the tree, as the arrow keys that move the cursor (see OnKeyDownTunnel). The keys of the selected row (Tree.Rename,
         Tree.Remove, Tree.Duplicate, Tree.MoveUp, Tree.MoveDown) are in the main window. -->
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding OpenSelectedCommand}" Gesture="{Binding Shortcuts[Tree.Open]}" />
    </UserControl.KeyBindings>

    <!-- The toolbar is over the tree. Its Add button opens the Add panel under it. -->
    <DockPanel Background="{DynamicResource TreeBackgroundBrush}">

    <Views:ProjectTreeToolbar
        Background="{DynamicResource Grey300Brush}"
        DockPanel.Dock="Top"
        Padding="{DynamicResource TreeToolbarPadding}" />

    <!-- The stripes are behind the tree, in the same cell, and follow its rows. A row is one pitch (row height plus space) from the next, so
         the bands stay under the rows whatever is open. The rows have their own fill, so the stripes show between them and beside them. -->
    <Grid>

    <ui:RowStripes
        x:Name="stripes"
        Opacity="0.6"
        Brush="{DynamicResource PanelBackgroundLevel1Brush}"
        RowHeight="{DynamicResource TreeRowHeight}"
        RowSpacing="{DynamicResource TreeRowGap}" />

    <TreeView
        x:Name="treeView"
        AutoScrollToSelectedItem="False"
        Margin="{DynamicResource TreeMargin}"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        FocusAdorner="{x:Null}"
        ItemsSource="{Binding Roots}"
        KeyboardNavigation.TabNavigation="Once"
        SelectedItem="{Binding SelectedNode, Mode=TwoWay}">

        <TreeView.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </TreeView.ItemsPanel>

        <TreeView.Styles>
            <!-- The bar lies over the rows, so the rows do not move when it appears. -->
            <Style Selector="TreeView /template/ ScrollViewer">
                <Setter Property="Theme" Value="{DynamicResource ScrollViewerOverlay}" />
            </Style>
            <Style Selector="TreeViewItem">
                <Setter Property="Theme" Value="{StaticResource TreeViewItemCMiX}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
            <TreeDataTemplate DataType="{x:Type Tree:TreeNode}" ItemsSource="{Binding Children}">

                <!-- The row of a list: an icon in the color of the name (the kind shows in the fill of the row) and the name.
                     The toggles are not here: they are at the right of the colored row (see RowToggles and the theme of the item). -->
                <DockPanel>

                    <ui:AppIcon
                        Margin="{DynamicResource TreeHeaderMargin}"
                        IconKey="{Binding IconKey}"
                        Size="{DynamicResource IconSizeXS}" />

                    <!-- The last child of the dock panel: the name takes all the room after the icon. A group has a text, an item has
                         a name that can be edited. A collapsed row shows what it holds (KindCountBadges) right after its name. -->
                    <Panel>
                        <ui:TextBoxEditable
                            Text="{Binding Item.PrefabService.Name.Value, Mode=TwoWay}"
                            IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ui:TextBoxEditable.Suffix>
                                <Views:KindCountBadges
                                    IsVisible="{Binding ShowsKindCounts}"
                                    IsHovered="{Binding $parent[TreeViewItem].IsPointerOver}"
                                    IsSelected="{Binding $parent[TreeViewItem].IsSelected}" />
                            </ui:TextBoxEditable.Suffix>
                        </ui:TextBoxEditable>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock
                                Margin="{DynamicResource TreeHeaderMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding Header}" />
                            <Views:KindCountBadges
                                IsVisible="{Binding ShowsKindCounts}"
                                IsHovered="{Binding $parent[TreeViewItem].IsPointerOver}"
                                IsSelected="{Binding $parent[TreeViewItem].IsSelected}" />
                        </StackPanel>
                    </Panel>

                </DockPanel>

            </TreeDataTemplate>
        </TreeView.DataTemplates>

    </TreeView>

    </Grid>

    </DockPanel>

</UserControl>
