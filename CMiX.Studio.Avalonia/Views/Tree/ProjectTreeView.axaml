<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- The toolbar is at the bottom, as the toolbar of the lists of compositions and layers. -->
    <DockPanel>

    <Views:ProjectTreeToolbar
        Background="{DynamicResource Grey300Brush}"
        DockPanel.Dock="Bottom"
        Padding="4" />

    <TreeView
        x:Name="treeView"
        Margin="8,8,0,8"
        Background="Transparent"
        BorderThickness="0"
        ItemsSource="{Binding Roots}"
        SelectedItem="{Binding SelectedNode, Mode=TwoWay}">

        <TreeView.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource SpacingXXS}" />
            </ItemsPanelTemplate>
        </TreeView.ItemsPanel>

        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="Theme" Value="{StaticResource TreeViewItemCMiX}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
            <TreeDataTemplate DataType="{x:Type Tree:TreeNode}" ItemsSource="{Binding Children}">

                <!-- The row of a list: an icon, the name, and on the right the toggles. A composition and a layer
                     have the visibility toggle and the mask toggle, as in the lists of the Composition and Layers tabs. -->
                <DockPanel>

                    <ui:AppIcon
                        Margin="4,0"
                        Opacity="0.7"
                        IconKey="{Binding IconKey}"
                        Size="{DynamicResource IconSizeXS}" />

                    <StackPanel
                        Margin="4,0"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingSM}"
                        IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- The mask toggle (a composition and a layer only), then the visibility toggle on the far right,
                             as in the rows of the lists. -->
                        <ContentControl Content="{Binding Item}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="{x:Type Compositing:Composition}">
                                    <ToggleButton
                                        IsChecked="{Binding Mask.IsMask.Value}"
                                        Theme="{DynamicResource ToggleButtonMask}"
                                        ToolTip.Tip="Mask" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type Compositing:Layer}">
                                    <ToggleButton
                                        IsChecked="{Binding Mask.IsMask.Value}"
                                        Theme="{DynamicResource ToggleButtonMask}"
                                        ToolTip.Tip="Mask" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type sys:Object}">
                                    <Panel />
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>

                        <ToggleButton
                            IsChecked="{Binding Item.PrefabService.Visibility.Value}"
                            Theme="{DynamicResource ToggleButtonVisibility}" />

                    </StackPanel>

                    <!-- The last child of the dock panel: the name takes all the room between the icon and the toggles,
                         as the name of a row of a list does. A group has a text, an item has a name that can be edited. -->
                    <Panel>
                        <ui:TextBoxEditable
                            Text="{Binding Item.PrefabService.Name.Value, Mode=TwoWay}"
                            IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Text="{Binding Header}"
                            IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>

                </DockPanel>

            </TreeDataTemplate>
        </TreeView.DataTemplates>

    </TreeView>

    </DockPanel>

</UserControl>
