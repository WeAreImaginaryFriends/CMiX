<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TreeSearchBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    HorizontalAlignment="Right">

    <!-- The search of the project tree, in the bar of the panel at the right. It is always shown while the panel shows the tree. The data
         context is the ProjectTree. The clear button is inside the field, at its right, while the field holds text (SearchBox.ShowsClear).
         During a drag the field and the clear button take no input, and the text stays (ProjectTree.IsDragging). The keys are in
         TreeSearchBox.axaml.cs. -->
    <ui:SearchBox
        x:Name="searchField"
        Width="{DynamicResource TreeSearchWidth}"
        IsReadOnly="{Binding IsDragging}"
        ShowsClear="True"
        Text="{Binding SearchText, Mode=TwoWay}"
        Watermark="Search" />

</UserControl>
