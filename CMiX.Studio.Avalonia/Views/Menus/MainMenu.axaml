<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Menus.MainMenu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Margin="0,0,0,2"
        Padding="2"
        Background="Transparent"
        BorderBrush="{DynamicResource Grey100Brush}"
        DockPanel.Dock="Top">
        <Menu
            Height="{DynamicResource ControlHeightMD}"
            Margin="0,0,0,0"
            HorizontalAlignment="Left"
            Theme="{StaticResource MenuDefault}">

            <MenuItem
                Padding="8,0"
                Header="File"
                Theme="{DynamicResource MenuItemTop}">

                <MenuItem
                    Padding="0,0,64,0"
                    Command="{Binding NewProjectCommand}"
                    Header="New" />

                <!-- The gesture comes from the shortcut map of the window (File.Open), as the key binding of the window. -->
                <MenuItem
                    Command="{Binding OpenProjectCommand}"
                    Header="Open"
                    InputGesture="{Binding $parent[Window].DataContext.Shortcuts[File.Open]}" />

                <MenuItem
                    Command="{Binding SaveProjectCommand}"
                    Header="Save" />

                <MenuItem
                    Command="{Binding SaveAsProjectCommand}"
                    Header="Save As" />

                <MenuItem
                    Command="{Binding CloseWindowCommand}"
                    Header="Quit" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                Header="Edit"
                Theme="{DynamicResource MenuItemTop}">

                <MenuItem
                    Command="{Binding UndoCommand}"
                    Header="Undo    Ctrl + Z" />

                <MenuItem
                    Command="{Binding RedoCommand}"
                    Header="Redo    Ctrl + Shift + Z" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                Header="Compo"
                Theme="{DynamicResource MenuItemTop}">

                <MenuItem
                    Command="{Binding AddCompositionCommand}"
                    Header="New Composition" />

                <MenuItem
                    Command="{Binding DeleteCompositionCommand}"
                    Header="Delete" />
                <MenuItem
                    Command="{Binding DuplicateCompositionCommand}"
                    Header="Duplicate" />
                <MenuItem Header="-" />
                <MenuItem Header="Import" />
                <MenuItem Header="Export" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                Header="Layer"
                Theme="{DynamicResource MenuItemTop}">
                <MenuItem
                    Command="{Binding AddLayerCommand}"
                    Header="New Layer" />
                <MenuItem
                    Command="{Binding DeleteLayerCommand}"
                    Header="Delete" />
                <MenuItem
                    Command="{Binding DuplicateLayerCommand}"
                    Header="Duplicate" />
            </MenuItem>

        </Menu>
    </Border>
</UserControl>
