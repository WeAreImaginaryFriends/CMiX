<ui:UserControlCaptioned
    x:Class="CMiX.Studio.Avalonia.Views.Modulation.FloatRangeEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="floatRangeEditor">

    <ui:UserControlCaptioned.Styles>
        <!-- An empty caption: no caption column, the RangeValue takes the full width. -->
        <Style Selector="ui|ContentCaptioned.bare">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ui:UserControlCaptioned.Styles>

    <ui:ContentCaptioned x:Name="captioned" Caption="{Binding Caption, ElementName=floatRangeEditor}">
        <ui:RangeValue
            LeftValue="{Binding Minimum.Value}"
            LeftCaption="Min"
            LeftResetCommand="{Binding Minimum.ResetCommand}"
            RightCaption="Max"
            RightResetCommand="{Binding Maximum.ResetCommand}"
            RightValue="{Binding Maximum.Value}" />
    </ui:ContentCaptioned>

</ui:UserControlCaptioned>
