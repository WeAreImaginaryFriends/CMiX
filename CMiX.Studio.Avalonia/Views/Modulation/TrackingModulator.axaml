<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TrackingModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Modulation:FloatRangeEditor Caption="X" DataContext="{Binding XRange}" />

        <Modulation:FloatRangeEditor Caption="Y" DataContext="{Binding YRange}" />

        <ui:ContentCaptioned Caption="Count" />

    </StackPanel>

</UserControl>
