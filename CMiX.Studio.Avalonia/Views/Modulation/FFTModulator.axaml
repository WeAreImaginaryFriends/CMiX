<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.FFTModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:IntegerValue
            Caption="Track Index"
            Minimum="0"
            Value="{Binding TrackIndex.Value}"
            ResetCommand="{Binding TrackIndex.ResetCommand}" />

        <ui:ContentCaptioned Caption="Bass">
            <ui:RangeValue
                DataContext="{Binding BassRange}"
                LeftValue="{Binding Minimum.Value}"
                LeftCaption="Min"
                LeftResetCommand="{Binding Minimum.ResetCommand}"
                RightCaption="Max"
                RightResetCommand="{Binding Maximum.ResetCommand}"
                RightValue="{Binding Maximum.Value}"/>
        </ui:ContentCaptioned>

        <ui:ContentCaptioned Caption="Lower Mid">
            <ui:RangeValue
                DataContext="{Binding LowerMidRange}"
                LeftValue="{Binding Minimum.Value}"
                LeftCaption="Min"
                LeftResetCommand="{Binding Minimum.ResetCommand}"
                RightCaption="Max"
                RightResetCommand="{Binding Maximum.ResetCommand}"
                RightValue="{Binding Maximum.Value}"/>
        </ui:ContentCaptioned>

        <ui:ContentCaptioned Caption="Higher Mid">
            <ui:RangeValue
                DataContext="{Binding HigherMidRange}"
                LeftValue="{Binding Minimum.Value}"
                LeftCaption="Min"
                LeftResetCommand="{Binding Minimum.ResetCommand}"
                RightCaption="Max"
                RightResetCommand="{Binding Maximum.ResetCommand}"
                RightValue="{Binding Maximum.Value}"/>
        </ui:ContentCaptioned>

        <ui:ContentCaptioned Caption="High">
            <ui:RangeValue
                DataContext="{Binding HighRange}"
                LeftValue="{Binding Minimum.Value}"
                LeftCaption="Min"
                LeftResetCommand="{Binding Minimum.ResetCommand}"
                RightCaption="Max"
                RightResetCommand="{Binding Maximum.ResetCommand}"
                RightValue="{Binding Maximum.Value}"/>
        </ui:ContentCaptioned>

    </StackPanel>

</UserControl>
