<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.FFTModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:IntegerValue
            Caption="Track Index"
            Minimum="0"
            Value="{Binding TrackIndex.Value}"
            ResetCommand="{Binding TrackIndex.ResetCommand}" />

        <Modulation:FloatRangeEditor Caption="Bass" DataContext="{Binding BassRange}" />

        <Modulation:FloatRangeEditor Caption="Lower Mid" DataContext="{Binding LowerMidRange}" />

        <Modulation:FloatRangeEditor Caption="Higher Mid" DataContext="{Binding HigherMidRange}" />

        <Modulation:FloatRangeEditor Caption="High" DataContext="{Binding HighRange}" />

    </StackPanel>

</UserControl>
