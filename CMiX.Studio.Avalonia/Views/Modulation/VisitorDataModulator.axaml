<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.VisitorDataModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Modulation:FloatRangeEditor Caption="Heart Rate" DataContext="{Binding HeartRateRange}" />

        <Modulation:FloatRangeEditor Caption="Temperature" DataContext="{Binding TemperatureRange}" />

        <Modulation:FloatRangeEditor Caption="Conductivity" DataContext="{Binding ConductivityRange}" />

        <Modulation:FloatRangeEditor Caption="ETemp" DataContext="{Binding ETempRange}" />

        <Modulation:FloatRangeEditor Caption="BlueIOT Pos X" DataContext="{Binding BlueIOTPosXRange}" />

        <Modulation:FloatRangeEditor Caption="BlueIOT Pos Y" DataContext="{Binding BlueIOTPosYRange}" />

        <ui:ContentCaptioned Caption="Count" />

    </StackPanel>

</UserControl>
