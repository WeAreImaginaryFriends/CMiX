<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Windows.MainWindowController"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <DockPanel>

        <ui:ButtonIcon
            Classes="window"
            Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding $parent[Window]}"
            DockPanel.Dock="Right"
            IconKey="Close" />

        <ui:ButtonIcon
            Classes="window"
            Command="{Binding MaximizeWindowCommand}"
            CommandParameter="{Binding $parent[Window]}"
            DockPanel.Dock="Right"
            IconKey="Maximize" />

        <ui:ButtonIcon
            Classes="window"
            Command="{Binding MinimizeWindowCommand}"
            CommandParameter="{Binding $parent[Window]}"
            DockPanel.Dock="Right"
            IconKey="Minimize" />

    </DockPanel>
</UserControl>
