<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Inspector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <!-- The editor of the row that is selected in the project tree. The DataContext is the ProjectTree.
         The editors are the views of the other tabs, so an item looks the same here and there. -->
    <!-- The toggles sit on squares, as in the rows of the tree (see RowToggles): the same size, the same fill. -->
    <UserControl.Styles>
        <Style Selector="Border.slot">
            <Setter Property="Width" Value="{DynamicResource ControlHeightMD}" />
            <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel2Brush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- The icon of the selected node on a square in the color of its kind, and its name. -->
        <Border
            Name="header"
            Height="{DynamicResource ControlHeightXL}"
            Padding="8,0"
            Background="{DynamicResource Grey200Brush}"
            DockPanel.Dock="Top"
            IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <!-- The badge, the name, and at the right end the toggles of the item: visibility, and the mask of a composition or a layer.
                 The name of an item can be edited here, as in the tree. A group has a name that can not be changed, and no toggle. -->
            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                <Views:CategoryBadge
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    DataContext="{Binding SelectedNode}" />

                <Panel Grid.Column="1" VerticalAlignment="Center">
                    <ui:TextBoxEditable
                        Name="nameEditor"
                        Text="{Binding SelectedNode.Item.PrefabService.Name.Value, Mode=TwoWay}"
                        IsVisible="{Binding SelectedNode.Item, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock
                        Name="title"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedNode.Header}"
                        IsVisible="{Binding SelectedNode.Item, Converter={x:Static ObjectConverters.IsNull}}" />
                </Panel>

                <StackPanel
                    Name="headerToggles"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingXXS}"
                    IsVisible="{Binding SelectedNode.Item, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border Classes="slot">
                        <ToggleButton
                            Name="visibilityToggle"
                            IsChecked="{Binding SelectedNode.Item.PrefabService.Visibility.Value}"
                            Theme="{DynamicResource ToggleButtonVisibility}" />
                    </Border>

                    <!-- The mask toggle: a composition and a layer only. The templates are only for those two types: a template for any
                         object would also catch the text of a tooltip. -->
                    <ContentControl Name="maskToggle" Content="{Binding SelectedNode.MaskOwner}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type Compositing:Composition}">
                                <Border Classes="slot">
                                    <ToggleButton
                                        IsChecked="{Binding Mask.IsMask.Value}"
                                        Theme="{DynamicResource ToggleButtonMask}"
                                        ToolTip.Tip="Mask" />
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type Compositing:Layer}">
                                <Border Classes="slot">
                                    <ToggleButton
                                        IsChecked="{Binding Mask.IsMask.Value}"
                                        Theme="{DynamicResource ToggleButtonMask}"
                                        ToolTip.Tip="Mask" />
                                </Border>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Name="placeholder"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Opacity="0.5"
            Text="Select an item in the tree"
            IsVisible="{Binding SelectedNode.InspectorContent, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}" />

        <ScrollViewer
            Name="scroller"
            VerticalScrollBarVisibility="Hidden"
            IsVisible="{Binding SelectedNode.InspectorContent, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">

            <i:Interaction.Behaviors>
                <ui:ScrollViewerBehavior />
            </i:Interaction.Behaviors>

            <ContentControl Name="editor" Content="{Binding SelectedNode.InspectorContent}">
                <ContentControl.DataTemplates>

                    <DataTemplate DataType="{x:Type Compositing:Composition}">
                        <StackPanel>
                            <Border Background="{DynamicResource Grey200Brush}">
                                <Views:ComposableItemSettings Margin="8" />
                            </Border>
                            <Views:Composition />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:Layer}">
                        <StackPanel>
                            <Border Background="{DynamicResource Grey200Brush}">
                                <Views:ComposableItemSettings Margin="8" />
                            </Border>
                            <Views:LayerPostFXTab />
                        </StackPanel>
                    </DataTemplate>

                    <!-- A group row of a layer shows the panel of the old tab for that kind: the list of the items and the editor of the
                         one that is chosen in it. The panels take the layer as their DataContext. -->
                    <DataTemplate DataType="{x:Type Tree:EntitiesGroup}">
                        <Views:LayerEntityTab DataContext="{Binding Layer}" />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:CamerasGroup}">
                        <Views:LayerCameraTab DataContext="{Binding Layer}" />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:LightsGroup}">
                        <Views:LayerLightTab DataContext="{Binding Layer}" />
                    </DataTemplate>

                    <!-- The groups of any item: the same panels as in the editors, for the list of the group. The panel that adds an item lists
                         what can be added to the owner, so it takes the type of the owner from the group. -->
                    <DataTemplate DataType="{x:Type Tree:ModifiersGroup}">
                        <Border Name="groupRoot">
                            <Views:ModifierManager Caption="Add Modifier" Margin="8" DataContext="{Binding Manager}">
                                <Views:ModifierManager.SelectionPanel>
                                    <Managers:AutoSelectionPanel PanelOwner="{Binding DataContext.OwnerType, ElementName=groupRoot}" />
                                </Views:ModifierManager.SelectionPanel>
                            </Views:ModifierManager>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:FiltersGroup}">
                        <Views:ModifierManager Caption="Add Filter" Margin="8" DataContext="{Binding Manager}">
                            <Views:ModifierManager.SelectionPanel>
                                <Managers:AutoSelectionPanel Interface="{x:Type Filters:ITextureFilter}" />
                            </Views:ModifierManager.SelectionPanel>
                        </Views:ModifierManager>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:ModulatorsGroup}">
                        <Views:ModifierManager Caption="Add Modulator" Margin="8" DataContext="{Binding Manager}">
                            <Views:ModifierManager.SelectionPanel>
                                <Managers:AutoSelectionPanel Interface="{x:Type Modulators:IModulator}" />
                            </Views:ModifierManager.SelectionPanel>
                        </Views:ModifierManager>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:TexturesGroup}">
                        <Views:DiffuseTexture DataContext="{Binding Owner.Texture.DiffuseTexture}" />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:Entity}">
                        <Views:ModelEntity />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:FullscreenQuad}">
                        <Views:FullscreenQuad />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:TextEntity}">
                        <Views:TextEntity />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Cameras:Camera}">
                        <Views:Camera />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Lights:LightEntity}">
                        <Views:LightEntity />
                    </DataTemplate>

                </ContentControl.DataTemplates>
            </ContentControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
