<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableItemSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <!-- The settings of a composition or of a layer: the mask settings when it is a mask, then the blend mode, the background and
         the alpha. The DataContext is the composition or the layer. The list of the compositions, the list of the layers and the
         inspector show the same settings with this one view. -->
    <StackPanel>
        <Views:ComposableManagerMaskSettings IsVisible="{Binding Mask.IsMask.Value}" />
        <Views:ComposableManagerSettings />
    </StackPanel>

</UserControl>
