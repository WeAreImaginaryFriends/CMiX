<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableManagerItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Border
        Background="Transparent"
        PointerPressed="Border_PointerPressed"
        PointerReleased="Border_PointerReleased">

        <DockPanel MinHeight="{DynamicResource ControlHeightMD}">

            <!-- The mask toggle, then the visibility toggle on the far right. -->
            <Views:ComposableToggles Margin="4,0" Classes="small" DockPanel.Dock="Right" />

            <!-- The name starts 8 from the left: 1 of the item padding, 3 of the margin and 4 of the text padding. -->
            <ui:TextBoxEditable
                x:Name="editableTextBox"
                Margin="3,0,0,0"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="{Binding PrefabService.Name.Value, Mode=TwoWay}" />

        </DockPanel>

    </Border>
</UserControl>
