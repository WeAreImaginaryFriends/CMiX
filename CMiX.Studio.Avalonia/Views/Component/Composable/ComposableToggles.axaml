<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableToggles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core">

    <!-- The visibility toggle and the mask toggle of an item. The DataContext is the item. Each toggle sits on a square (slot).
         A slot with no button is empty and darker (Grey100): the visibility slot of a group (no item), the mask slot of an item
         that is not an IComposable. The mask template is for IComposable only: a template for any object also catches the text of
         the tooltip, and the tooltip is an empty box.
         Sizes: no class is the inspector header (ControlHeightMD), "row" is the tree (TreeRowHeight, TreeRowSpacing, no fill: the icons sit
         inside the colored row), "small" is the
         composable lists (ControlHeightXS, no fill). In every size the mask is first and the visibility is on the far right. -->
    <UserControl.Styles>
        <Style Selector="Border.slot">
            <Setter Property="Width" Value="{DynamicResource ControlHeightMD}" />
            <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel2Brush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        </Style>
        <Style Selector="Border.slot.empty">
            <Setter Property="Background" Value="{DynamicResource Grey100Brush}" />
        </Style>
        <Style Selector="Border.gap">
            <Setter Property="Width" Value="{DynamicResource SpacingXXS}" />
        </Style>
        <Style Selector="Border.visibility">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="Border.mask">
            <Setter Property="Grid.Column" Value="0" />
        </Style>

        <Style Selector="Views|ComposableToggles.row Border.slot">
            <Setter Property="Width" Value="{DynamicResource TreeRowHeight}" />
            <Setter Property="Height" Value="{DynamicResource TreeRowHeight}" />
        </Style>
        <Style Selector="Views|ComposableToggles.row Border.slot, Views|ComposableToggles.row Border.slot.empty">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Views|ComposableToggles.row Border.gap">
            <Setter Property="Width" Value="{DynamicResource TreeRowSpacing}" />
        </Style>

        <Style Selector="Views|ComposableToggles.small Border.slot">
            <Setter Property="Width" Value="{DynamicResource ControlHeightXS}" />
            <Setter Property="Height" Value="{DynamicResource ControlHeightXS}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Views|ComposableToggles.small Border.gap">
            <Setter Property="Width" Value="{DynamicResource SpacingSM}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,Auto,Auto">

        <Border Classes="slot visibility" Classes.empty="{Binding $parent[Views:ComposableToggles].DataContext, Converter={x:Static ObjectConverters.IsNull}}">
            <ToggleButton
                x:Name="visibilityToggle"
                IsChecked="{Binding PrefabService.Visibility.Value}"
                IsVisible="{Binding $parent[Views:ComposableToggles].DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                Theme="{DynamicResource ToggleButtonVisibility}" />
        </Border>

        <Border Grid.Column="1" Classes="gap" />

        <Border Classes="slot mask" Classes.empty="{Binding $parent[Views:ComposableToggles].Composable, Converter={x:Static ObjectConverters.IsNull}}">
            <ContentControl Content="{Binding $parent[Views:ComposableToggles].Composable}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type Compositing:IComposable}">
                        <ToggleButton
                            x:Name="maskToggle"
                            IsChecked="{Binding Mask.IsMask.Value}"
                            Theme="{DynamicResource ToggleButtonMask}"
                            ToolTip.Tip="Mask" />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

    </Grid>

</UserControl>
