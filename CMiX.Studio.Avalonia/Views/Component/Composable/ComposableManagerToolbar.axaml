<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableManagerToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <DockPanel 

        LastChildFill="False">

        <ui:ButtonIcon
            Command="{Binding AddItemCommand}"
            CommandParameter="{Binding $parent[Views:ComposableManager].ItemType}"
            IconKey="Add" />

        <ui:ButtonIcon
            x:Name="DuplicateButton"
            Command="{Binding DuplicateItemCommand}"
            CommandParameter="{Binding SelectedItem}"
            IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
            IconKey="Duplicate" />

        <Border IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ui:ButtonIcon
                    Command="{Binding ManagerReorderService.MoveItemUpCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    IconKey="ArrowUp" />

                <ui:ButtonIcon
                    Command="{Binding ManagerReorderService.MoveItemDownCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    IconKey="ArrowDown" />
            </StackPanel>
        </Border>

        <ui:ButtonIcon
            x:Name="RemoveButton"
            Command="{Binding RemoveItemCommand}"
            CommandParameter="{Binding SelectedItem}"
            DockPanel.Dock="Right"
            IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
            IconKey="Remove" />

    </DockPanel>
</UserControl>
