<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BeatControls"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:ContentCaptioned Caption="Beat">

        <ui:DockPanelPositioned>

            <ui:ButtonIcon
                Command="{Binding MultiplyCommand}"
                DockPanel.Dock="Right"
                Classes="filled"
                IconKey="Add" />

            <ui:ButtonIcon
                Margin="1,0,1,0"
                Command="{Binding DivideCommand}"
                DockPanel.Dock="Right"
                Classes="filled"
                IconKey="Sub" />

            <Border
                x:Name="MainBorder"
                Height="{DynamicResource ControlHeightMD}"
                Background="{DynamicResource Grey500Brush}"
                CornerRadius="{DynamicResource CornerRadiusLeft}">
                <Panel>
                    <Border
                        Background="{DynamicResource Grey700Brush}"
                        CornerRadius="{DynamicResource CornerRadiusLeft}">
                        <Border.Opacity>
                            <MultiBinding Converter="{StaticResource MultiPeriodToBeatAnimation}">
                                <Binding Path="BeatIndex.Value" />
                                <Binding Path="." />
                                <Binding Path="MasterBeat.AnimatedDouble.AnimationPosition" />
                            </MultiBinding>
                        </Border.Opacity>
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{Binding BPM, StringFormat=F2}" />
                </Panel>

            </Border>

        </ui:DockPanelPositioned>

    </ui:ContentCaptioned>

</UserControl>
