<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MasterBeatControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel ui:EditCycle.IsLoop="True">

        <ui:DragValue
            Margin="0,0,0,8"
            Caption="BPM"
            IsInteger="False"
            LargeChange="1.0"
            Minimum="1"
            SmallChange="0.01"
            Value="{Binding BPM, Mode=TwoWay}" />

        <ui:ContentCaptioned>

            <DockPanel VerticalAlignment="Center">

                <ui:ButtonIcon
                    Margin="4,0,0,0"
                    Command="{Binding Resync.ClickCommand}"
                    DockPanel.Dock="Right"
                    Classes="filled"
                    IconKey="Reset" />

                <ui:DockPanelPositioned>

                    <ToggleButton
                        Width="{Binding $self.Bounds.Height}"
                        Margin="0,0,1,0"
                        Background="Transparent"
                        Content="P"
                        DockPanel.Dock="Left"
                        IsChecked="{Binding Pause.Value}" />

                    <ui:ButtonIcon
                        Command="{Binding MultiplyCommand}"
                        DockPanel.Dock="Right"
                        Classes="filled"
                        IconKey="Add" />

                    <ui:ButtonIcon
                        Margin="1,0"
                        Command="{Binding DivideCommand}"
                        DockPanel.Dock="Right"
                        Classes="filled"
                        IconKey="Sub" />

                    <Panel>
                        <Border
                            Background="{DynamicResource Grey600Brush}"
                            Opacity="{Binding AnimatedDouble.AnimationPosition}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            Command="{Binding TapCommand}"
                            Content="TAP"
                            ui:PositionedControl.Position="None" />
                    </Panel>

                </ui:DockPanelPositioned>

            </DockPanel>
        </ui:ContentCaptioned>
    </StackPanel>
</UserControl>
