<Window
    x:Class="CMiX.Studio.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:TextureSources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Menus="clr-namespace:CMiX.Studio.Avalonia.Views.Menus"
    xmlns:Windows="clr-namespace:CMiX.Studio.Avalonia.Views.Windows"

    Title="CMiX"
    Width="908"
    Height="1000"
    Background="{DynamicResource Grey100Brush}"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1"
    ExtendClientAreaToDecorationsHint="True"
    Focusable="True"
    WindowStartupLocation="Manual">

    <!-- The gestures come from the shortcut map (see ShortcutMap). A change of the map changes the binding. The keys of the tree are here,
         not in the tree, so they also run with the focus on the window. Every key of the tree has one condition: the tree has the focus,
         or the pointer is over the tree and no other panel has the focus. No key runs while a text box has the focus. No key runs during
         a drag of a row, but Tree.Expand, which then acts on the row under the pointer (see ProjectTree.CanRunTreeKey). -->
    <Window.KeyBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="{Binding Shortcuts[Edit.Undo]}" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="{Binding Shortcuts[Edit.Redo]}" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="{Binding Shortcuts[Edit.RedoAlt]}" />
        <KeyBinding Command="{Binding MainMenu.OpenProjectCommand}" Gesture="{Binding Shortcuts[File.Open]}" />
        <!-- The panel keys move the focus between the side panels (see PanelFocusCycle). They also run with the focus in a text box. -->
        <KeyBinding Command="{Binding PanelFocus.NextPanelCommand}" Gesture="{Binding Shortcuts[Window.NextPanel]}" />
        <KeyBinding Command="{Binding PanelFocus.PreviousPanelCommand}" Gesture="{Binding Shortcuts[Window.PreviousPanel]}" />
        <KeyBinding Command="{Binding PanelFocus.FocusPanel1Command}" Gesture="{Binding Shortcuts[Window.FocusPanel1]}" />
        <KeyBinding Command="{Binding PanelFocus.FocusPanel2Command}" Gesture="{Binding Shortcuts[Window.FocusPanel2]}" />
        <KeyBinding Command="{Binding PanelFocus.FocusPanel3Command}" Gesture="{Binding Shortcuts[Window.FocusPanel3]}" />
        <KeyBinding Command="{Binding PanelFocus.FocusPanel4Command}" Gesture="{Binding Shortcuts[Window.FocusPanel4]}" />
        <KeyBinding Command="{Binding PanelFocus.FocusTreeCommand}" Gesture="{Binding Shortcuts[Tree.Focus]}" />
        <KeyBinding Command="{Binding ProjectTree.AddAtTargetCommand}" Gesture="{Binding Shortcuts[Tree.Add]}" />
        <KeyBinding Command="{Binding ProjectTree.OpenMenuAtTargetCommand}" Gesture="{Binding Shortcuts[Tree.Menu]}" />
        <KeyBinding Command="{Binding ProjectTree.ToggleExpandTargetCommand}" Gesture="{Binding Shortcuts[Tree.Expand]}" />
        <KeyBinding Command="{Binding ProjectTree.CollapseOthersCommand}" Gesture="{Binding Shortcuts[Tree.CollapseOthers]}" />
        <KeyBinding Command="{Binding ProjectTree.ExpandBranchCommand}" Gesture="{Binding Shortcuts[Tree.ExpandBranch]}" />
        <KeyBinding Command="{Binding ProjectTree.CloseLevelCommand}" Gesture="{Binding Shortcuts[Tree.CloseLevel]}" />
        <KeyBinding Command="{Binding ProjectTree.OpenLevelCommand}" Gesture="{Binding Shortcuts[Tree.OpenLevel]}" />
        <KeyBinding Command="{Binding ProjectTree.CollapseAllCommand}" Gesture="{Binding Shortcuts[Tree.CollapseAll]}" />
        <KeyBinding Command="{Binding ProjectTree.FocusSearchCommand}" Gesture="{Binding Shortcuts[Tree.Search]}" />
        <KeyBinding Command="{Binding ProjectTree.RenameSelectedByKeyCommand}" Gesture="{Binding Shortcuts[Tree.Rename]}" />
        <KeyBinding Command="{Binding ProjectTree.RemoveItemByKeyCommand}" Gesture="{Binding Shortcuts[Tree.Remove]}" />
        <KeyBinding Command="{Binding ProjectTree.DuplicateItemByKeyCommand}" Gesture="{Binding Shortcuts[Tree.Duplicate]}" />
        <KeyBinding Command="{Binding ProjectTree.MoveItemUpByKeyCommand}" Gesture="{Binding Shortcuts[Tree.MoveUp]}" />
        <KeyBinding Command="{Binding ProjectTree.MoveItemDownByKeyCommand}" Gesture="{Binding Shortcuts[Tree.MoveDown]}" />
        <KeyBinding Command="{Binding ProjectTree.RevealSelectedCommand}" Gesture="{Binding Shortcuts[Tree.Reveal]}" />
    </Window.KeyBindings>

    <DockPanel Background="{DynamicResource Grey100Brush}" LastChildFill="True">

        <Border
            x:Name="titleBar"
            Background="{DynamicResource Grey100Brush}"
            DockPanel.Dock="Top">

            <DockPanel LastChildFill="True">

                <Windows:MainWindowController DataContext="{Binding MainWindowController}" DockPanel.Dock="Right" />

                <ui:TextBlockTrimmed
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DataContext="{Binding MainMenu}"
                    Text="{Binding TitleBarText}"
                    ToolTipText="{Binding FolderPath}" />

            </DockPanel>
        </Border>

        <Menus:MainMenu
            DataContext="{Binding MainMenu}"
            DockPanel.Dock="Top" />

        <Border
            Height="{DynamicResource ControlHeightXL}"
            Background="{DynamicResource Grey100Brush}"
            BorderBrush="{DynamicResource Grey100Brush}"
            BorderThickness="2,0,2,2"
            DockPanel.Dock="Bottom">

            <Views:SyncStatusIndicator
                Margin="8,0"
                HorizontalAlignment="Right"
                DataContext="{Binding Sync}" />

        </Border>

        <!-- The tree and the tabs have the same width. -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="240" Width="*" />
                <ColumnDefinition MinWidth="240" Width="*" />
            </Grid.ColumnDefinitions>

        <!-- Each side shows what the user picks with the icon button at its top: the tree, the tabs, or the same thing on both sides. -->
        <Views:SidePanelHost
            Grid.Column="0"
            Choice="{Binding LeftPanel, Mode=TwoWay}"
            Choices="{Binding PanelChoices}"
            Context="{Binding}" />

        <Views:SidePanelHost
            Grid.Column="1"
            Choice="{Binding RightPanel, Mode=TwoWay}"
            Choices="{Binding PanelChoices}"
            Context="{Binding}" />

        <!-- The splitter lies over the edge between the two columns, on top of them, so it takes no room: there is no gap between
             the panels. It is in the left column, at its right edge, and moves that edge. The part as wide as the scroll bar margin is over the tree,
             where the scroll bar of the tree ends. The rest is in the right column (see SplitterColumnOverlap). -->
        <GridSplitter
            Grid.Column="0"
            Width="{DynamicResource SplitterSize}"
            Margin="{DynamicResource SplitterColumnOverlap}"
            HorizontalAlignment="Right"
            ResizeDirection="Columns"
            Theme="{StaticResource GridSplitterCMiX}" />

        <!-- The one toast of the window, at the bottom center over both panels (see IToastService). It takes no click and no focus. -->
        <ui:ToastHost x:Name="toastHost" Grid.ColumnSpan="2" />

        </Grid>
    </DockPanel>

</Window>
