<Window
    x:Class="CMiX.Studio.Avalonia.Views.Dialogs.MoveBlockedDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    Background="Transparent"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    SystemDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner">

    <!-- The frame is the one of the menus and the flyouts: the same panel color and the same window shadow. -->
    <ui:PopupFrame PanelMinWidth="380">

        <StackPanel Spacing="{DynamicResource SpacingMD}">

            <DockPanel>
                <ui:AppIcon
                    Margin="8"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Left"
                    Opacity="0.9"
                    IconKey="Warning"
                    Size="{DynamicResource IconSizeLG}" />
                <TextBlock
                    x:Name="MessageText"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ForegroundBrush}"
                    TextWrapping="Wrap" />
            </DockPanel>

            <Button
                x:Name="OkButton"
                Margin="4"
                HorizontalAlignment="Right"
                MinWidth="100"
                Click="OnOk"
                Content="OK" />

        </StackPanel>

    </ui:PopupFrame>

</Window>
