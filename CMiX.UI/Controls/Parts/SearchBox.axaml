<UserControl
    x:Class="CMiX.UI.Controls.Parts.SearchBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="searchBox">

    <!-- The search field of every list and drop-down that filters its rows. The magnifier is inside the field, at its left. The text starts after it. -->
    <Panel>

        <TextBox
            x:Name="PART_Search"
            Height="{DynamicResource ControlHeightMD}"
            Padding="28,0,6,0"
            VerticalContentAlignment="Center"
            IsReadOnly="{Binding IsReadOnly, ElementName=searchBox}"
            Text="{Binding Text, ElementName=searchBox, Mode=TwoWay}"
            Watermark="{Binding Watermark, ElementName=searchBox}" />

        <ui:AppIcon
            x:Name="PART_SearchIcon"
            Margin="8,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IconKey="Search"
            IsHitTestVisible="False"
            Opacity="0.5"
            Size="{DynamicResource IconSizeXS}" />

    </Panel>

</UserControl>
