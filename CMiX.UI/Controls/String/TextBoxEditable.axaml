<UserControl
    x:Class="CMiX.UI.Controls.String.TextBoxEditable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="editableTextBox">

    <Grid
        Height="{DynamicResource ControlHeightMD}"
        Background="Transparent">

        <!-- The TextBox has a 1 border, so its padding is 3,1. The text then starts at the same place as in the TextBlock (4,0). -->
        <!-- Only as wide as its text: a double tap on the text starts the edit mode, a double tap on the rest of the row does not.
             The least width keeps an empty name easy to hit. -->
        <TextBlock
            x:Name="TextDisplay"
            MinWidth="{DynamicResource ControlHeightMD}"
            Padding="4,0"
            Background="Transparent"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Foreground="{Binding Foreground, ElementName=editableTextBox}"
            Text="{Binding Text, ElementName=editableTextBox}" />

        <!-- The input has no binding to Text: it gets the text when the edit starts, and gives it back when the edit ends.
             So the text of the owner never holds a half edited or an empty text. -->
        <TextBox
            x:Name="InputValue"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            CaretBrush="{DynamicResource AccentInactiveBrush}"
            ContextFlyout="{x:Null}"
            Padding="3,1"
            Foreground="{DynamicResource ActiveForegroundBrush}"
            SelectionBrush="{DynamicResource AccentBrush}" />
    </Grid>

</UserControl>
