<ui:ItemPickerBase
    x:Class="CMiX.UI.Controls.Collection.SearchableItemPickerList"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="searchablePicker">

    <!-- The search field, then the rows that match it. The rows are an ItemPickerList, so a long list scrolls. -->
    <StackPanel Spacing="4">

        <!-- The magnifier is inside the field, at its left. The text starts after it. -->
        <Panel>

            <TextBox
                x:Name="PART_Search"
                Height="{DynamicResource ControlHeightMD}"
                Padding="28,0,6,0"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, ElementName=searchablePicker, Mode=TwoWay}"
                Watermark="Search" />

            <ui:AppIcon
                x:Name="PART_SearchIcon"
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IconKey="Search"
                IsHitTestVisible="False"
                Opacity="0.5"
                Size="{DynamicResource IconSizeXS}" />

        </Panel>

        <ui:ItemPickerList
            x:Name="PART_List"
            ItemCommand="{Binding ItemCommand, ElementName=searchablePicker}"
            ItemsSource="{Binding Matches, ElementName=searchablePicker}"
            TextPath="{Binding TextPath, ElementName=searchablePicker}" />

        <TextBlock
            x:Name="PART_NoMatch"
            Margin="8,0,0,4"
            IsVisible="False"
            Opacity="0.5"
            Text="No match" />

    </StackPanel>

</ui:ItemPickerBase>
