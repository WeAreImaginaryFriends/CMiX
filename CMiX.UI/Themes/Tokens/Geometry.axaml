<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CornerRadiusNone">0</CornerRadius>

    <!-- Base radius: 2 -->
    <CornerRadius x:Key="CornerRadiusAll">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusTop">2,2,0,0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBottom">0,0,2,2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLeft">2,0,0,2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusRight">0,2,2,0</CornerRadius>

    <!-- Large radius: 4 -->
    <CornerRadius x:Key="CornerRadiusLargeAll">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLargeBottom">0,0,4,4</CornerRadius>

    <!-- The space around a card, such as ExpanderIndented: SpacingXS at the sides, SpacingXXS above and below. -->
    <Thickness x:Key="MarginCard">2,1</Thickness>

    <!-- Control heights -->
    <x:Double x:Key="ControlHeightXS">16</x:Double>
    <x:Double x:Key="ControlHeightMD">24</x:Double>
    <x:Double x:Key="ControlHeightXL">30</x:Double>
    <x:Double x:Key="ControlHeightXXL">34</x:Double>
    <!-- Sizes of small parts. They are not control heights, but they sit in the same scale. -->
    <x:Double x:Key="IndicatorSize">8</x:Double>
    <x:Double x:Key="SplitterSize">8</x:Double>
    <x:Double x:Key="SplitterIndicatorSize">2</x:Double>
    <!-- A horizontal splitter lies over the edge between two rows: half of its height in each row. -->
    <Thickness x:Key="SplitterRowOverlap">0,-4</Thickness>
    <!-- A vertical splitter lies over the edge between two columns: SplitterSize less the scroll bar margin is in the right column. -->
    <Thickness x:Key="SplitterColumnOverlap">0,0,-6,0</Thickness>
    <!-- The room of a scroll bar: ScrollBarThickness plus the two sides of ScrollBarMargin. A test pins the sum. -->
    <x:Double x:Key="ScrollBarSize">8</x:Double>
    <!-- The width of the vertical bar itself. -->
    <x:Double x:Key="ScrollBarThickness">4</x:Double>
    <!-- The space at the two sides of a bar. -->
    <Thickness x:Key="ScrollBarMargin">2,0,2,0</Thickness>
    <!-- The room that the content of an overlay scroll viewer leaves on the right for the bar: ScrollBarSize.
         The bar lies in this room, so the content has one width with a bar and without one. -->
    <Thickness x:Key="ScrollBarGutter">0,0,8,0</Thickness>
    <x:Double x:Key="SeparatorSize">0.5</x:Double>
    <!-- The least width of the visible panel of every menu and popup, without the margin of the shadow.
         More content makes it wider. A popup can follow the width of its toggle instead: TogglePopup.MatchesToggleWidth. -->
    <x:Double x:Key="PopupMinWidth">200</x:Double>
    <x:Double x:Key="ColorWheelSize">200</x:Double>

    <!-- Multi line text boxes: two lines and four lines. -->
    <x:Double x:Key="TextAreaHeight2">44</x:Double>
    <x:Double x:Key="TextAreaHeight4">88</x:Double>

    <!--
        Icon glyph sizes - deliberately separate from ControlHeight*, which sizes
        control bounding boxes, not glyph size. See Views/Controls/AppIcon.
    -->
    <x:Double x:Key="IconSizeXS">16</x:Double>
    <x:Double x:Key="IconSizeSM">12</x:Double>
    <x:Double x:Key="IconSizeMD">16</x:Double>
    <x:Double x:Key="IconSizeLG">24</x:Double>

    <!-- Lists and drop downs. The height of each is a number of rows of ControlHeightMD, plus the
         margins and the spaces around the rows. No other file holds one of these numbers.
         ListBoxCMiX: ListVisibleItems rows + the top and bottom of ListScrollMargin.
         ListBoxEditable: ListEditableVisibleItems rows + the spaces of ListSpacing + ListEditablePadding.
         ComboBox: ComboBoxVisibleItems rows. -->
    <x:Int32 x:Key="ListVisibleItems">5</x:Int32>
    <Thickness x:Key="ListScrollMargin">2</Thickness>
    <x:Double x:Key="ListResizeHandleHeight">12</x:Double>
    <x:Int32 x:Key="ListEditableVisibleItems">4</x:Int32>
    <x:Double x:Key="ListSpacing">2</x:Double>
    <Thickness x:Key="ListEditablePadding">4</Thickness>
    <x:Int32 x:Key="ComboBoxVisibleItems">7</x:Int32>

    <!-- The size of the text: about half a row of ControlHeightMD, rounded. -->
    <x:Double x:Key="FontSizeMD">12</x:Double>

    <!-- Spacing scale for Margin/Padding -->
    <x:Double x:Key="SpacingXXS">1</x:Double>
    <x:Double x:Key="SpacingXS">2</x:Double>
    <x:Double x:Key="SpacingSM">4</x:Double>
    <x:Double x:Key="SpacingMD">8</x:Double>

    <!-- The space inside the card of a tooltip and of the Add panel: SpacingMD above and below, 10 at the sides. -->
    <Thickness x:Key="PopupCardPadding">10,8</Thickness>

    <!-- The widest line of a tooltip. A longer description wraps. -->
    <x:Double x:Key="TipMaxWidth">260</x:Double>

    <!-- The width of the list inside the Add panel, without the card around it. -->
    <x:Double x:Key="AddPanelWidth">200</x:Double>

    <!-- The project tree. Tests pin the numbers that the code also holds. -->
    <!-- The indent of one level, and the width of the chevron. -->
    <x:Double x:Key="TreeIndent">16</x:Double>
    <!-- TreeIndent at the left: the drop line starts after the chevron. -->
    <Thickness x:Key="TreeIndentMargin">16,0,0,0</Thickness>
    <!-- The space between two rows at a screen of 100%. The view sets it again in whole pixels. -->
    <x:Double x:Key="TreeRowGap">3</x:Double>
    <!-- The space around the tree: SpacingMD at the left, top and bottom. The scroll bar gutter is at the right. -->
    <Thickness x:Key="TreeMargin">8,8,0,8</Thickness>
    <!-- The space before the content of a row: SpacingXS. -->
    <Thickness x:Key="TreeRowContentMargin">2,0,0,0</Thickness>
    <!-- The space at the two sides of the icon and the name of a row: SpacingSM. -->
    <Thickness x:Key="TreeHeaderMargin">4,0</Thickness>
    <!-- The space inside the toolbar of the tree: SpacingSM. -->
    <Thickness x:Key="TreeToolbarPadding">4</Thickness>
    <!-- The width of the search field of the tree, in the bar of the panel, at the right. -->
    <x:Double x:Key="TreeSearchWidth">160</x:Double>

    <!-- A drag near the edge of a view. -->
    <!-- The height of the zone at the top and the bottom edge that scrolls the view. -->
    <x:Double x:Key="DragScrollEdge">28</x:Double>
    <!-- The largest scroll of one step of the timer. -->
    <x:Double x:Key="DragScrollStep">18</x:Double>
    <!-- The distance that a press moves before a drag starts. -->
    <x:Double x:Key="DragThreshold">4</x:Double>

    <!-- The frame of the cursor row: CursorFrameThickness while the list has the focus, CursorFrameInactiveThickness when it does not. -->
    <Thickness x:Key="CursorFrameThickness">2</Thickness>
    <Thickness x:Key="CursorFrameInactiveThickness">1</Thickness>

    <!-- Opacities. A style file holds no opacity as a number. -->
    <!-- A disabled control. -->
    <x:Double x:Key="OpacityDisabled">0.5</x:Double>
    <!-- The item that a drag moves, at its old place. -->
    <x:Double x:Key="OpacityDragSource">0.4</x:Double>
    <!-- The copy of the item that follows the pointer during a drag. -->
    <x:Double x:Key="OpacityDragGhost">0.8</x:Double>
    <!-- An icon only control that is not under the pointer and not on. -->
    <x:Double x:Key="OpacityIconIdle">0.6</x:Double>

</ResourceDictionary>
