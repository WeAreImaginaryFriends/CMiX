<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Grey100">#FF111113</Color>
    <Color x:Key="Grey200">#FF222224</Color>
    <Color x:Key="Grey300">#FF2b2b2e</Color>
    <Color x:Key="Grey400">#FF353539</Color>
    <Color x:Key="Grey500">#FF404044</Color>
    <Color x:Key="Grey600">#FF4c4c51</Color>
    <Color x:Key="Grey700">#FF606065</Color>
    <Color x:Key="Grey800">#FF808087</Color>
    <Color x:Key="Grey900">#FFb0b0b8</Color>

    <Color x:Key="AccentPrimary">#FF5680C2</Color>
    <Color x:Key="AccentSecondary">#FF4d6490</Color>
    <Color x:Key="Active">#FF5680C2</Color>

    <Color x:Key="AccentHighlight">#FF91ACD7</Color>

    <!-- The colors of the modulator assign button, one pair for each ModulatorCategory.
         The name is Modulator + category + (Highlight when the modulator is hovered).
         A new category needs two colors here and two brushes in Brushes.axaml. -->
    <Color x:Key="ModulatorUnassigned">#FF606065</Color>
    <Color x:Key="ModulatorInternal">#FF5680C2</Color>
    <Color x:Key="ModulatorInternalHighlight">#FF91ACD7</Color>
    <Color x:Key="ModulatorExternal">#FFC28A56</Color>
    <Color x:Key="ModulatorExternalHighlight">#FFD7B091</Color>

    <!-- The two bands behind the rows of the tree of the project. They are very close, so the rows are easy to follow without a pattern that pulls the eye. -->
    <Color x:Key="RowStripeA">#FF111113</Color>
    <Color x:Key="RowStripeB">#FF18181A</Color>

    <Color x:Key="Text">#FFE0E0E0</Color>
    <Color x:Key="ActiveText">#FFFFFFFF</Color>

</ResourceDictionary>
