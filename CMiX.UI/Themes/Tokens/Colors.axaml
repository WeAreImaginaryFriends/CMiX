<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Grey100">#FF111113</Color>
    <Color x:Key="Grey200">#FF222224</Color>
    <Color x:Key="Grey300">#FF2b2b2e</Color>
    <Color x:Key="Grey400">#FF353539</Color>
    <Color x:Key="Grey500">#FF404044</Color>
    <Color x:Key="Grey600">#FF4c4c51</Color>
    <Color x:Key="Grey700">#FF606065</Color>
    <Color x:Key="Grey800">#FF808087</Color>
    <Color x:Key="Grey900">#FFb0b0b8</Color>

    <!-- The color under the rows of the project tree: the window surface (Grey100). The palette of the rows mixes against it. -->
    <Color x:Key="TreeBackground">#FF111113</Color>

    <Color x:Key="AccentPrimary">#FF5680C2</Color>
    <Color x:Key="AccentSecondary">#FF4d6490</Color>
    <Color x:Key="Active">#FF5680C2</Color>

    <Color x:Key="AccentHighlight">#FF91ACD7</Color>

    <!-- The colors of the modulator assign button, one pair for each ModulatorCategory.
         The name is Modulator + category + (Highlight when the modulator is hovered).
         A new category needs two colors here and two brushes in Brushes.axaml. -->
    <Color x:Key="ModulatorUnassigned">#FF606065</Color>
    <Color x:Key="ModulatorInternal">#FF5680C2</Color>
    <Color x:Key="ModulatorInternalHighlight">#FF91ACD7</Color>
    <Color x:Key="ModulatorExternal">#FFC28A56</Color>
    <Color x:Key="ModulatorExternalHighlight">#FFD7B091</Color>

    <!-- The colors of the kinds of row in the project tree, one for each TreeCategory.
         A composable inside a composable moves its hue one step for each level of nesting (Level1 to Level3).
         The tree reads them by the name Category + kind, and shows them as tones over the panel background. -->
    <Color x:Key="CategoryComposable">#FFDC74D7</Color>
    <Color x:Key="CategoryComposableLevel1">#FFC874E4</Color>
    <Color x:Key="CategoryComposableLevel2">#FFB27DEA</Color>
    <Color x:Key="CategoryComposableLevel3">#FF9F85EC</Color>
    <Color x:Key="CategoryEntity">#FFE56C9E</Color>
    <Color x:Key="CategoryCamera">#FFE66756</Color>
    <Color x:Key="CategoryLight">#FFE9D349</Color>
    <Color x:Key="CategoryTexture">#FF9DCE64</Color>
    <Color x:Key="CategoryFilter">#FF60C7A2</Color>
    <Color x:Key="CategoryModifier">#FF68B6D4</Color>
    <Color x:Key="CategoryModulator">#FF9A8BE4</Color>

    <!-- A muted warning tone, not a full red: the frame of a tree row that refuses a dragged node. -->
    <Color x:Key="DropBlocked">#FFB0675C</Color>

    <Color x:Key="Text">#FFE0E0E0</Color>
    <Color x:Key="ActiveText">#FFFFFFFF</Color>

</ResourceDictionary>
