<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Shadow" Opacity="0.2" Color="Black" />

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentInactiveBrush" Color="{DynamicResource AccentSecondary}" />
    <SolidColorBrush x:Key="AccentHighlightBrush" Color="{DynamicResource AccentHighlight}" />

    <!-- The modulator assign button. The studio finds these by name: Modulator + category + (Highlight) + Brush. -->
    <SolidColorBrush x:Key="ModulatorUnassignedBrush" Color="{DynamicResource ModulatorUnassigned}" />
    <SolidColorBrush x:Key="ModulatorInternalBrush" Color="{DynamicResource ModulatorInternal}" />
    <SolidColorBrush x:Key="ModulatorInternalHighlightBrush" Color="{DynamicResource ModulatorInternalHighlight}" />
    <SolidColorBrush x:Key="ModulatorExternalBrush" Color="{DynamicResource ModulatorExternal}" />
    <SolidColorBrush x:Key="ModulatorExternalHighlightBrush" Color="{DynamicResource ModulatorExternalHighlight}" />

    <SolidColorBrush x:Key="PanelBackground" Opacity="0.3" Color="Black" />
    <SolidColorBrush x:Key="PanelBorderBackground" Opacity="0.4" Color="Black" />
    <SolidColorBrush x:Key="ListBoxBackground" Opacity="0.4" Color="Black" />

    <SolidColorBrush x:Key="PanelBackgroundLevel1Brush" Color="{DynamicResource Grey200}" />
    <SolidColorBrush x:Key="PanelBackgroundLevel2Brush" Color="{DynamicResource Grey300}" />
    <SolidColorBrush x:Key="PanelBackgroundLevel3Brush" Color="{DynamicResource Grey400}" />

    <!-- The background of every popup, flyout, drop down and context menu. PopupFrame and DropdownFrame read it. -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupCardBackground}" />

    <!-- The line of a tooltip that says why a control is disabled, and the colors of a menu row that takes something away. -->
    <SolidColorBrush x:Key="PopupCardWarningBrush" Color="{DynamicResource PopupCardWarning}" />
    <SolidColorBrush x:Key="PopupCardDangerBrush" Color="{DynamicResource PopupCardDanger}" />

    <!-- The background of the project tree and the layer that dims a row. -->
    <SolidColorBrush x:Key="TreeBackgroundBrush" Color="{DynamicResource TreeBackground}" />


    <SolidColorBrush x:Key="Grey100Brush" Color="{DynamicResource Grey100}" />
    <SolidColorBrush x:Key="Grey200Brush" Color="{DynamicResource Grey200}" />
    <SolidColorBrush x:Key="Grey300Brush" Color="{DynamicResource Grey300}" />
    <SolidColorBrush x:Key="Grey400Brush" Color="{DynamicResource Grey400}" />
    <SolidColorBrush x:Key="Grey500Brush" Color="{DynamicResource Grey500}" />
    <SolidColorBrush x:Key="Grey600Brush" Color="{DynamicResource Grey600}" />
    <SolidColorBrush x:Key="Grey700Brush" Color="{DynamicResource Grey700}" />
    <SolidColorBrush x:Key="Grey800Brush" Color="{DynamicResource Grey800}" />
    <SolidColorBrush x:Key="Grey900Brush" Color="{DynamicResource Grey900}" />

    <!-- The states of the controls. Every theme reads these brushes, so a grey changes in one place.
         Surface controls (buttons, toggles, combo boxes, values, sliders): idle, then one step up under the pointer,
         then one step down from idle while pressed (a press makes the control darker). The on state is accent-inactive, and accent under the pointer.
         Rows (list items, menu items, tabs): transparent, then RowHover under the pointer. -->
    <SolidColorBrush x:Key="StateIdleBrush" Color="{DynamicResource Grey600}" />
    <SolidColorBrush x:Key="StateHoverBrush" Color="{DynamicResource Grey700}" />
    <SolidColorBrush x:Key="StatePressedBrush" Color="{DynamicResource Grey100}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{DynamicResource Grey500}" />

    <!-- A muted warning: the frame of a target that refuses a drop, the mark of a conflict. -->
    <SolidColorBrush x:Key="WarningMutedBrush" Color="{DynamicResource WarningMuted}" />

    <!-- The frame of the cursor row of a list: ActiveText while the list has the focus, Grey800 when it does not. -->
    <SolidColorBrush x:Key="CursorFrameBrush" Color="{DynamicResource ActiveText}" />
    <SolidColorBrush x:Key="CursorFrameInactiveBrush" Color="{DynamicResource Grey800}" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource Text}" />
    <SolidColorBrush x:Key="ActiveForegroundBrush" Color="{DynamicResource ActiveText}" />

    <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" DestinationRect="0,0,16,16">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource Grey300Brush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource Grey100Brush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- The text of a shortcut (the class shortcut of a TextBlock), and the frame of a key cap (TextBlockKeyCap). -->
    <SolidColorBrush x:Key="ShortcutTextBrush" Color="{DynamicResource ShortcutText}" />
    <SolidColorBrush x:Key="KeyCapBorderBrush" Color="{DynamicResource Grey600}" />

</ResourceDictionary>
