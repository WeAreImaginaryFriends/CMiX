<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A scroll viewer whose bars lie over the content. The content has the same size with a bar and without one,
         so it does not move when the bar appears. The default template puts the vertical bar in a column of its own,
         and that column takes the width of the bar and of its margins from the content only while the bar is shown.
         Here the content always leaves that room on the right (ScrollBarGutter), and the bar lies in it. -->
    <ControlTheme x:Key="ScrollViewerOverlay" TargetType="ScrollViewer">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <ScrollContentPresenter
                        Name="PART_ContentPresenter"
                        Margin="{DynamicResource ScrollBarGutter}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                        HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                        ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}"
                        VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                        VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer
                                CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}" />
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar
                        Name="PART_HorizontalScrollBar"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal" />
                    <ScrollBar
                        Name="PART_VerticalScrollBar"
                        HorizontalAlignment="Right"
                        Orientation="Vertical" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Margin" Value="{DynamicResource ScrollBarMargin}" />

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border>
                        <Track
                            DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsDirectionReversed="True"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Orientation="{TemplateBinding Orientation}"
                            ViewportSize="{TemplateBinding ViewportSize}"
                            Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton
                                    Name="PART_PageUpButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton
                                    Name="PART_PageDownButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource ScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border>
                        <Track
                            DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Orientation="{TemplateBinding Orientation}"
                            ViewportSize="{TemplateBinding ViewportSize}"
                            Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton
                                    Name="PART_PageUpButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton
                                    Name="PART_PageDownButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--  ScrollBar Thumb, the part that can be dragged up/down or left/right  -->
        <Style Selector="^ /template/ Thumb#thumb">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CornerRadiusAll}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^ /template/ Thumb#thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>
        <!-- A thumb that is dragged stays lit. Its idle grey is the pressed grey of a control, so the pressed token would show nothing. -->
        <Style Selector="^ /template/ Thumb#thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>

        <!--  ScrollBar page repeat buttons, the long area between the buttons, not the thumb  -->
        <Style Selector="^ /template/ RepeatButton.repeattrack">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="Black"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        Opacity="0.2" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
