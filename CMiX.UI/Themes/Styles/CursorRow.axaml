<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The cursor frame of a row (see CursorRow and the theme CursorFrame) while its list or tree has the keyboard focus:
        CursorFrameBrush and CursorFrameThickness. Without the focus, the frame keeps the thin grey look of the row theme.
        A style in a ControlTheme can not read a pseudo class of the list around the row, so these styles are global.
    -->
    <Style Selector=":is(ListBox):focus-within :is(ListBoxItem).cursor /template/ Border#CursorFrame">
        <Setter Property="BorderBrush" Value="{DynamicResource CursorFrameBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CursorFrameThickness}" />
    </Style>
    <Style Selector=":is(TreeView):focus-within :is(TreeViewItem).cursor /template/ Border#CursorFrame">
        <Setter Property="BorderBrush" Value="{DynamicResource CursorFrameBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CursorFrameThickness}" />
    </Style>

</Styles>
