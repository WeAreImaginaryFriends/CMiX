<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Template structure follows the Avalonia Simple theme Window skeleton with CMiX visual properties applied -->

    <DropShadowEffect
        x:Key="DropShadowWindow"
        BlurRadius="8"
        Color="Black"
        OffsetX="0"
        OffsetY="0"
        Opacity="0.5" />

    <!-- The shadow of a row that is raised over the rows around it: the cursor row of the tree. It is larger and darker than the
         shadow of a popup, because a row lies on rows that are as dark as it is. -->
    <DropShadowEffect
        x:Key="DropShadowRow"
        BlurRadius="16"
        Color="Black"
        OffsetX="0"
        OffsetY="2"
        Opacity="0.9" />

</ResourceDictionary>
