<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:behaviors="clr-namespace:CMiX.UI.Behaviors;assembly=CMiX.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CMiX.UI/Themes/Tokens/Converters.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme x:Key="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type Button}}" TargetType="ToggleButton">
        <Style Selector="^:checked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource StateOnHoverBrush}" />
        </Style>

        <Style Selector="^:unchecked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>

        <Style Selector="^:unchecked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
        </Style>
    </ControlTheme>

    <!-- A toggle that is only an icon. The icon is dim at rest and lit under the pointer. A theme based on
         this one sets the icon with IconKey in a style, and a second icon for the on state with the same style
         under :checked. The opacities are styles, not local values. A local value would block the states. -->
    <ControlTheme x:Key="ToggleButtonIcon" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Width" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent">
                    <ui:AppIcon Name="icon" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#border">
            <Setter Property="Opacity" Value="{DynamicResource OpacityIconIdle}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonVisibility" BasedOn="{StaticResource ToggleButtonIcon}" TargetType="ToggleButton">
        <!-- A drag over these buttons sets them all to one state (see ToggleDragBehavior). -->
        <Setter Property="behaviors:ToggleDrag.Group" Value="visibility" />
        <Setter Property="ToolTip.Tip" Value="Visible" />

        <Style Selector="^ /template/ ui|AppIcon#icon">
            <Setter Property="IconKey" Value="Visible" />
        </Style>

        <Style Selector="^:checked /template/ ui|AppIcon#icon">
            <Setter Property="IconKey" Value="NotVisible" />
        </Style>
    </ControlTheme>

    <!-- An on and off switch for a panel or a part. The icon is dim while off and lit while on. -->
    <ControlTheme x:Key="ToggleButtonPower" BasedOn="{StaticResource ToggleButtonIcon}" TargetType="ToggleButton">
        <Style Selector="^ /template/ ui|AppIcon#icon">
            <Setter Property="IconKey" Value="Power" />
        </Style>

        <Style Selector="^:checked /template/ Border#border">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

    <!-- The switch that tells that an object runs its update. -->
    <ControlTheme
        x:Key="ToggleButtonUpdate"
        BasedOn="{StaticResource ToggleButtonPower}"
        TargetType="ToggleButton">
        <Style Selector="^ /template/ ui|AppIcon#icon">
            <Setter Property="IconKey" Value="Update" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonPlayPause" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent">
                    <ui:AppIcon Name="image" IconKey="Play" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- A style, not a value on the template. A value there would beat every style. -->
        <Style Selector="^ /template/ Border#border">
            <Setter Property="Opacity" Value="{DynamicResource OpacityIconIdle}" />
        </Style>

        <Style Selector="^:checked /template/ ui|AppIcon#image">
            <Setter Property="IconKey" Value="Stop" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonPopup" TargetType="ToggleButton">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Background="{DynamicResource StateIdleBrush}"
                    CornerRadius="{DynamicResource CornerRadiusLeft}">
                    <Grid>
                        <ui:AppIcon Margin="8,0,0,0" HorizontalAlignment="Left" IconKey="Add" Opacity="{DynamicResource OpacityIconAction}" Size="{DynamicResource IconSizeXS}" />
                        <TextBlock HorizontalAlignment="Center" Padding="8,4,4,4" Text="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>

        <Style Selector="^:checked /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
    </ControlTheme>

    <!-- The one check box of CMiX: a box with a check mark. It reacts to its own hover. It does not take a click: its owner does. -->
    <ControlTheme x:Key="{x:Type ui:CheckMark}" TargetType="ui:CheckMark">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="box"
                    Width="{DynamicResource ControlHeightXS}"
                    Height="{DynamicResource ControlHeightXS}"
                    Padding="4"
                    Background="{DynamicResource StateIdleBrush}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ui:AppIcon
                        Name="icon"
                        IconKey="IsChecked"
                        Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#box">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#box">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:checked:pointerover /template/ Border#box">
            <Setter Property="Background" Value="{DynamicResource StateOnHoverBrush}" />
        </Style>
        <Style Selector="^:checked /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#box">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>
    </ControlTheme>

    <!-- A toggle that is only the check box, for a toggle inside another control. -->
    <ControlTheme x:Key="ToggleButtonBox" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ui:CheckMark IsChecked="{TemplateBinding IsChecked}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The check box in the value column, with the Caption beside it. A click on the box or on the Caption changes it. -->
    <ControlTheme x:Key="{x:Type ui:ToggleButtonCaptioned}" TargetType="ui:ToggleButtonCaptioned">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ui:ContentCaptioned>
                    <DockPanel Background="Transparent">
                        <ui:CheckMark
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{TemplateBinding IsChecked}" />
                        <TextBlock
                            Padding="4,0"
                            HorizontalAlignment="Left"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Caption}" />
                    </DockPanel>
                </ui:ContentCaptioned>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
