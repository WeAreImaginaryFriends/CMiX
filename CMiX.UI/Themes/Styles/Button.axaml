<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CMiX.UI/Themes/Tokens/Converters.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="(ui:PositionedControl.Position)" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{Binding (ui:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToCornerRadius}}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>
    </ControlTheme>

    <!-- A button at the right end of a control that shows no hover and no press: the modulator button of a value. -->
    <ControlTheme x:Key="ButtonRoundedRightNoHover"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="(ui:PositionedControl.Position)" Value="Right" />
        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!-- The one icon button: a square with one icon. With no class it has no fill: a toolbar button.
         The corners follow PositionedControl.Position, as for every button. -->
    <ControlTheme x:Key="{x:Type ui:ButtonIcon}"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="ui:ButtonIcon">
        <Setter Property="Width" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IconSize" Value="{DynamicResource IconSizeXS}" />
        <Setter Property="IconOpacity" Value="{DynamicResource OpacityIconAction}" />

        <!-- The class filled gives the fill of a button: an icon button that is a part of a group of controls, such as the
             buttons under a list. Without the class, the button has no fill: a toolbar button. -->
        <Style Selector="^.filled">
            <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
        </Style>

        <!-- The class quiet: no fill at all, also under the pointer. The icon is dim at rest and lit under the pointer.
             The close button of a panel and the clear button of a search field have it. -->
        <Style Selector="^.quiet">
            <Setter Property="IconOpacity" Value="{DynamicResource OpacityIconIdle}" />
        </Style>
        <Style Selector="^.quiet:pointerover">
            <Setter Property="IconOpacity" Value="1" />
        </Style>
        <Style Selector="^.quiet:pointerover /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^.quiet:pressed /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- The class handle: the handle that drags a row or a panel. It has no fill and the hand cursor. -->
        <Style Selector="^.handle">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^.handle:pointerover /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^.handle:pressed /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- The class window: a button of the title bar of the window. It is larger and square, and its icon is dim at rest. -->
        <Style Selector="^.window">
            <Setter Property="Width" Value="{DynamicResource ControlHeightXL}" />
            <Setter Property="Height" Value="{DynamicResource ControlHeightXL}" />
            <Setter Property="(ui:PositionedControl.Position)" Value="None" />
            <Setter Property="IconOpacity" Value="{DynamicResource OpacityIconIdle}" />
        </Style>
        <Style Selector="^.window:pointerover">
            <Setter Property="IconOpacity" Value="1" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ButtonMomentary}"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="ui:ButtonMomentary">
        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:held /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonColor" TargetType="ToggleButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">

                    <Border
                        Name="mask"
                        Classes="BorderMask"
                        ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToNoAlpha}}"
                        IsHitTestVisible="False" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1"
                                CornerRadius="{DynamicResource CornerRadiusRight}"
                                Background="{DynamicResource CheckerboardBrush}" />

                        <Border
                            Name="borderAlpha"
                            Grid.Column="1"
                            CornerRadius="{DynamicResource CornerRadiusRight}">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border.Background>
                        </Border>

                        <Border
                            Name="border"
                            Grid.Column="0"
                            Background="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToNoAlpha}}"
                            CornerRadius="{DynamicResource CornerRadiusLeft}" />

                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#borderAlpha">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ButtonItem" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
        </Style>

        <!-- The row that Enter picks in a list that has the keyboard focus elsewhere. It looks like a hovered row. -->
        <Style Selector="^.highlighted">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="^.highlighted /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>
    </ControlTheme>

    <!-- A button whose Caption is its label. Under the pointer and while pressed it has the accent. -->
    <ControlTheme x:Key="{x:Type ui:ButtonCaptioned}"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="ui:ButtonCaptioned">
        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
