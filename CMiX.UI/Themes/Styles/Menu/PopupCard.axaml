<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The room of the shadow is the outer padding, as in PopupFrame. The tip is inside that room. -->
    <ControlTheme x:Key="{x:Type ui:PopupCard}" TargetType="ui:PopupCard">
        <Setter Property="Padding" Value="{DynamicResource PopupCardPadding}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource DropShadowWindow}"
                    Padding="{x:Static ui:PopupFrame.ShadowMargin}">

                    <Panel>
                        <Border
                            Name="PART_Card"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                        <ui:PopupTip
                            Name="PART_Tip"
                            Fill="{DynamicResource PopupBackgroundBrush}"
                            IsVisible="{TemplateBinding ShowsTip}" />
                    </Panel>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A FlyoutPresenter for a flyout whose content is a PopupCard. The card has its own frame, shadow and tip, so the presenter adds none. -->
    <ControlTheme x:Key="FlyoutPresenterCard" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
