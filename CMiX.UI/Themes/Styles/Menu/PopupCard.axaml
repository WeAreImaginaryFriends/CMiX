<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The surface is a PopupSurface. The tip lies on it, inside the room of the shadow. -->
    <ControlTheme x:Key="{x:Type ui:PopupCard}" TargetType="ui:PopupCard">
        <Setter Property="Padding" Value="{DynamicResource PopupCardPadding}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ui:PopupSurface Padding="{TemplateBinding Padding}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <ui:PopupSurface.Overlay>
                        <ui:PopupTip
                            Name="PART_Tip"
                            Fill="{DynamicResource PopupBackgroundBrush}"
                            IsVisible="{Binding ShowsTip, RelativeSource={RelativeSource AncestorType=ui:PopupCard}}" />
                    </ui:PopupSurface.Overlay>
                </ui:PopupSurface>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A FlyoutPresenter for a flyout whose content is a PopupCard. The card has its own frame, shadow and tip, so the presenter adds none. -->
    <ControlTheme x:Key="FlyoutPresenterCard" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
