<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- A row of a context menu. A row with children opens a submenu: its panel is a PopupFrame like the panel of the menu,
         and its rows have this theme too. -->
    <ControlTheme x:Key="MenuItemContext" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource MenuItemContext}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="root"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    Background="{TemplateBinding Background}">
                    <Grid VerticalAlignment="Center">
                        <!-- The icon, the label, the shortcut and the arrow of a row that opens something. The shortcut and the arrow have the
                             same width in every row of a menu, so they line up. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuArrow" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Name="PART_IconPresenter"
                            Grid.Column="0"
                            Width="{DynamicResource IconSizeXS}"
                            Height="{DynamicResource IconSizeXS}"
                            Margin="0,0,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}"
                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter
                            Name="PART_HeaderPresenter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="sys:String">
                                    <AccessText Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>
                        <TextBlock
                            Name="PART_InputGestureText"
                            Grid.Column="2"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource FontFamilyMono}"
                            Foreground="{DynamicResource Grey700Brush}"
                            IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Text="{TemplateBinding InputGesture, Converter={StaticResource KeyGestureText}}" />
                        <ui:AppIcon
                            Name="PART_Arrow"
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IconKey="ChevronRight"
                            Opacity="0.7"
                            Size="{DynamicResource IconSizeXS}" />

                        <Popup
                            Name="PART_Popup"
                            IsLightDismissEnabled="False"
                            IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                            Placement="RightEdgeAlignedTop">
                            <ui:PopupFrame PanelMinWidth="{DynamicResource PopupMinWidth}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </ui:PopupFrame>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:separator">
            <!-- NaN clears the row height, so the row is as high as the thin line. -->
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Separator
                        Height="{DynamicResource SeparatorSize}"
                        Margin="0,4"
                        Background="{DynamicResource Grey600Brush}" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- In a menu, the hover and the row of the arrow keys are one thing, so they have the same fill. -->
        <Style Selector="^:pointerover /template/ Border#root, ^:selected /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
        </Style>

        <Style Selector="^:checked /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#root">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- The arrow shows on a row that has a submenu, and on a row with the class opens (a row that opens a panel beside the menu). -->
        <Style Selector="^:empty /template/ ui|AppIcon#PART_Arrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^.opens /template/ ui|AppIcon#PART_Arrow">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- The first row of a menu names its owner. It is quiet, and it is not dimmed as a disabled row. -->
        <Style Selector="^.title /template/ Border#root">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^.title /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Grey800Brush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- A row that takes something away, such as Delete. -->
        <Style Selector="^.danger /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource PopupCardDangerBrush}" />
        </Style>
    </ControlTheme>

    <!-- The look of every menu popup. A context menu and a menu flyout derive from it. -->
    <ControlTheme x:Key="MenuPanel" TargetType="MenuBase">
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource MenuItemContext}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ui:PopupFrame CentersOnPointer="True" PanelMinWidth="{DynamicResource PopupMinWidth}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue" />
                    </ScrollViewer>
                </ui:PopupFrame>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ContextMenuDefault" TargetType="ContextMenu" BasedOn="{StaticResource MenuPanel}">
        <Setter Property="ui:ContextMenuPointerAway.IsEnabled" Value="True" />
    </ControlTheme>

    <ControlTheme x:Key="MenuFlyoutPresenterDefault" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource MenuPanel}" />

</ResourceDictionary>
