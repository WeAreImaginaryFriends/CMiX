<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The one surface of a popup. The outer padding is the room of the shadow. -->
    <ControlTheme x:Key="{x:Type ui:PopupSurface}" TargetType="ui:PopupSurface">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource DropShadowWindow}"
                    Padding="{TemplateBinding ShadowMargin}">
                    <Panel>
                        <Border
                            Name="PART_Surface"
                            MinWidth="{TemplateBinding SurfaceMinWidth}"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Overlay}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
