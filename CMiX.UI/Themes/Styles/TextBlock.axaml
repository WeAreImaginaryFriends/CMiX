<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The one look of a shortcut: in a tooltip, in a menu row and in a key cap (TextBlockKeyCap).
         It is a style and not a control theme, because a style wins over the TextBlock style above. -->
    <Style Selector="TextBlock.shortcut">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="Foreground" Value="{DynamicResource ShortcutTextBrush}" />
    </Style>

    <!-- On the hover fill of a menu row, the shortcut is lighter, so it stays readable. -->
    <Style Selector="MenuItem:pointerover /template/ TextBlock.shortcut, MenuItem:selected /template/ TextBlock.shortcut">
        <Setter Property="Foreground" Value="{DynamicResource ShortcutTextHoverBrush}" />
    </Style>

    <!-- A text that is the content of a control that is on, or of a row that is selected, lies on the accent: it is ActiveForegroundBrush.
         These styles are here and not in the themes of the controls: a ControlTheme can not style a child of its control. -->
    <Style Selector="ToggleButton:checked > TextBlock, RadioButton:checked > TextBlock, ListBoxItem:selected > TextBlock, ComboBoxItem:selected > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
    </Style>

    <!-- The header of an expander is a toggle that is checked while the expander is open. It is not on the accent: its text does not change. -->
    <Style Selector="ToggleButton#PART_toggle:checked > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock:disabled">
        <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
    </Style>

</Styles>
